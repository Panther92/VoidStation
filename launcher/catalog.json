  "apps": [
    {
      "id": "steam",
      "name": "Steam + Proton-GE",
      "cat": "Gaming",
      "desc": "Steam im Big-Picture-Modus für den Fernseher, nativ aus dem Void-Repo (nonfree + multilib, 32-Bit-Grafiktreiber passend zur GPU), dazu das aktuelle Proton-GE für Windows-Spiele.",
      "source": {
        "type": "xbps",
        "pkg": "steam",
        "repos": [
          "void-repo-nonfree",
          "void-repo-multilib",
          "void-repo-multilib-nonfree"
        ],
        "deps": [
          "libgcc-32bit",
          "libstdc++-32bit",
          "libdrm-32bit",
          "libglvnd-32bit",
          "libva-32bit",
          "mesa-dri-32bit",
          "vulkan-loader",
          "vulkan-loader-32bit"
        ],
        "optional": [
          "libpulseaudio-32bit",
          "alsa-pipewire-32bit"
        ],
        "gpu_deps": {
          "intel": [
            "mesa-vulkan-intel",
            "mesa-vulkan-intel-32bit"
          ],
          "amd": [
            "mesa-vulkan-radeon",
            "mesa-vulkan-radeon-32bit"
          ]
        },
        "addons": [
          "proton-ge"
        ]
      },
      "cmd": [
        "steam",
        "-gamepadui"
      ],
      "tile": {
        "group": "Spiele",
        "size": "wide",
        "color": "#1b2838",
        "icon": "gamepad",
        "sub": "Big Picture"
      },
      "note": "Beim ersten Start lädt Steam sich selbst herunter (ca. 300 MB). Für Windows-Spiele einmalig in Steam: Einstellungen → Kompatibilität → GE-Proton wählen.",
      "start_hint": "Beim ersten Start lädt Steam Updates herunter und richtet sich ein – das kann einige Minuten dauern. Danach geht es deutlich schneller.",
      "arch": [
        "x86_64"
      ]
    },
