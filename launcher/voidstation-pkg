#!/bin/sh
# SPDX-License-Identifier: GPL-3.0-or-later
# voidstation-pkg – kleiner Root-Helfer fuer das AppCenter.
# Darf per sudo ohne Passwort laufen, installiert/entfernt aber NUR Pakete
# aus der Freigabeliste, fuehrt System-Updates aus und aktualisiert
# VoidStation selbst – immer aus der fest hinterlegten Quelle
# (/usr/local/share/voidstation/update-url, gehoert root), nie aus einer
# Datei, die der Benutzer vorgibt.
#
# Alles steckt in main(): die Shell liest die Funktion komplett ein, bevor
# sie laeuft. So stoert es nicht, wenn das Selbst-Update diese Datei ersetzt.

ALLOW=/usr/local/share/voidstation/allowed-packages
URLFILE=/usr/local/share/voidstation/update-url
CHANNELFILE=/usr/local/share/voidstation/channel
SIGNERS=/usr/local/share/voidstation/allowed_signers
XCHOICE=/usr/local/share/voidstation/xserver         # frueher: Wahl XLibre/X.Org (wird entfernt)
XLIBRE_REPO=https://github.com/xlibre-void/xlibre/releases/latest/download
XLIBRE_KEYFP=00:ca:42:57:c9:c0:9a:ec:94:b4:7d:97:e5:a9:aa:1e
export LC_ALL=C

check_pkgs() {
  [ $# -gt 0 ] || { echo "kein Paket angegeben"; return 2; }
  for pkg in "$@"; do
    case "$pkg" in *[!A-Za-z0-9._+-]*|"") echo "ungueltiger Paketname: $pkg"; return 2 ;; esac
    grep -qx "$pkg" "$ALLOW" 2>/dev/null || { echo "nicht freigegeben: $pkg"; return 2; }
  done
}

update_url() {
  ch="$(head -n1 "$CHANNELFILE" 2>/dev/null)"
  case "$ch" in stable|main) ;; *) ch=stable ;; esac
  head -n1 "$URLFILE" 2>/dev/null | sed "s/{channel}/$ch/"
}

selfupdate() {
  url="$(update_url)"
  case "$url" in https://*) ;; *) echo "keine gueltige Update-Adresse in $URLFILE"; return 2 ;; esac
  user="${SUDO_USER:-}"
  case "$user" in ""|root|*[!a-z0-9_-]*) echo "Selbst-Update nur per sudo von einem normalen Benutzer"; return 2 ;; esac
  command -v curl >/dev/null 2>&1 || xbps-install -Sy curl >/dev/null 2>&1
  tmp="$(mktemp -d /tmp/voidstation-update.XXXXXX)" || return 1   # gehoert root, 0700
  echo "Lade $url/update.sh"
  if ! curl -fsSL --proto '=https' --tlsv1.2 --retry 2 -o "$tmp/update.sh" "$url/update.sh"; then
    echo "Download fehlgeschlagen"; rm -rf "$tmp"; return 1
  fi
  if [ "$(head -c 11 "$tmp/update.sh")" != '#!/bin/bash' ] || ! grep -q '^__PAYLOAD_BELOW__$' "$tmp/update.sh"; then
    echo "Unerwarteter Inhalt – Update abgebrochen"; rm -rf "$tmp"; return 1
  fi
  if [ -s "$SIGNERS" ]; then
    # Nur Updates mit gueltiger Signatur des Herausgebers werden ausgefuehrt
    if ! curl -fsSL --proto '=https' --tlsv1.2 --retry 2 -o "$tmp/update.sh.sig" "$url/update.sh.sig"; then
      echo "Signatur fehlt – Update abgelehnt"; rm -rf "$tmp"; return 1
    fi
    if ! ssh-keygen -Y verify -f "$SIGNERS" -I voidstation-release -n voidstation \
         -s "$tmp/update.sh.sig" < "$tmp/update.sh" >/dev/null 2>&1; then
      echo "Signatur UNGUELTIG – Update abgelehnt"; rm -rf "$tmp"; return 1
    fi
    echo "Signatur geprueft: ok"
  else
    echo "Hinweis: noch kein Signaturschluessel hinterlegt – Update ohne Signaturpruefung"
  fi
  VSUSER="$user" SUDO_USER="$user" VOIDSTATION_NONINTERACTIVE=1 bash "$tmp/update.sh" </dev/null
  rc=$?
  rm -rf "$tmp"
  return $rc
}

# ---------------------------------------------------------------------
#  Bluetooth-Dienst (bluetoothd) an/aus
# ---------------------------------------------------------------------
suspend_now() {
  # Standby (Suspend-to-RAM bzw. s2idle). Bevorzugt ueber elogind: dann erfahren NetworkManager, BlueZ & Co.
  # vorher davon (PrepareForSleep) und melden sich danach selbst wieder. Rueckfall: zzz (runit-void).
  states="$(cat /sys/power/state 2>/dev/null)"
  case " $states " in *" mem "*|*" freeze "*) ;; *) echo "Standby wird von diesem Geraet nicht unterstuetzt"; return 3 ;; esac
  [ -e /etc/voidstation-live ] && { echo "Im Live-System gibt es keinen Standby"; return 3; }
  if command -v loginctl >/dev/null 2>&1 && loginctl suspend 2>/dev/null; then return 0; fi
  echo "elogind nicht erreichbar – Standby ueber zzz"
  zzz -z
}

bluetooth_ctl() {
  case "$1" in
    on)
      [ -d /etc/sv/bluetoothd ] || xbps-install -Sy bluez || return 1
      if [ -f /etc/bluetooth/input.conf ]; then
        # (sysfix.sh stellt BlueZ bei jedem Update ein – hier nur fuer nachtraeglich installiertes bluez)
        grep -Eq '^UserspaceHID *= *true' /etc/bluetooth/input.conf || sed -Ei 's/^#*UserspaceHID *=.*/UserspaceHID=true/' /etc/bluetooth/input.conf
        grep -Eq '^ClassicBondedOnly *= *false' /etc/bluetooth/input.conf || sed -Ei 's/^#*ClassicBondedOnly *=.*/ClassicBondedOnly=false/' /etc/bluetooth/input.conf
      fi
      rfkill unblock bluetooth 2>/dev/null || true     # per Funkschalter gesperrt
      [ -e /var/service/bluetoothd ] || ln -s /etc/sv/bluetoothd /var/service/
      echo "Bluetooth an"
      ;;
    off) rm -f /var/service/bluetoothd; echo "Bluetooth aus" ;;
    status|"") [ -e /var/service/bluetoothd ] && echo on || echo off ;;
    *) echo "bluetooth: on | off | status"; return 2 ;;
  esac
}

# ---------------------------------------------------------------------
#  Grafik-Server: ausschliesslich XLibre (Pakete von xlibre-void)
# ---------------------------------------------------------------------
xlibre_key() {   # Signaturschluessel des xlibre-void-Repos (Fingerabdruck geprueft: 00:ca:42:57:…)
  cat <<'KEYEOF'
<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple Computer//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>public-key</key>
	<data></data>
	<key>public-key-size</key>
	<integer>2048</integer>
	<key>signature-by</key>
	<string>xlibre-github-actions</string>
</dict>
</plist>
KEYEOF
}

xlibre_repo() {   # Paketquelle + fest hinterlegter Schluessel
  mkdir -p /etc/xbps.d /var/db/xbps/keys
  xlibre_key > "/var/db/xbps/keys/$XLIBRE_KEYFP.plist"
  echo "repository=$XLIBRE_REPO" > /etc/xbps.d/99-repository-xlibre.conf
}
xlibre_ok() { xbps-query xlibre-xserver >/dev/null 2>&1; }
xorg_left() { xbps-query xorg-server >/dev/null 2>&1 || xbps-query xorg-minimal >/dev/null 2>&1; }
xorg_cleanup() {
  xbps-query xorg-minimal >/dev/null 2>&1 && xbps-remove -Ry xorg-minimal
  xbps-query xorg-server  >/dev/null 2>&1 && xbps-remove -Fy xorg-server
  return 0
}

# XLibre sicherstellen; ersetzt ein noch vorhandenes X.Org (Geraete von vor 0.7.0)
xserver_ensure() {
  rm -f "$XCHOICE"                       # fruehere Wahl XLibre/X.Org gibt es nicht mehr
  xlibre_repo
  if xlibre_ok && ! xorg_left; then echo "XLibre ist aktiv."; return 0; fi
  echo "Lade Paketlisten (XLibre) …"
  if ! xbps-install -S >/dev/null || ! xbps-query -R xlibre-minimal >/dev/null 2>&1; then
    echo "XLibre-Paketquelle nicht erreichbar."
    xlibre_ok && return 0
    return 1
  fi
  if xlibre_ok; then echo "Entferne X.Org-Reste …"; xorg_cleanup; echo "XLibre ist aktiv."; return 0; fi
  # Erst alles herunterladen, dann tauschen – scheitert der Download, bleibt alles wie es ist
  echo "Lade XLibre herunter …"
  if ! xbps-install -Dy xlibre-minimal xinit xauth >/dev/null; then echo "Download fehlgeschlagen – nichts geaendert."; return 1; fi
  xorg_left && xbps-install -Dfy xorg-minimal >/dev/null 2>&1   # nur fuer den Notfall im Zwischenspeicher
  echo "Entferne X.Org …"
  xorg_cleanup
  echo "Installiere XLibre …"
  if xbps-install -y xlibre-minimal xinit xauth && xlibre_ok; then
    echo "XLibre installiert – aktiv ab dem naechsten Neustart."
    return 0
  fi
  # Ohne jeden X-Server gaebe es keine Oberflaeche mehr: vorlaeufig X.Org zurueck, naechstes Update versucht es erneut
  echo "XLibre-Installation fehlgeschlagen – X.Org bleibt vorlaeufig installiert."
  xbps-install -y xorg-minimal >/dev/null 2>&1 || xbps-install -Sy xorg-minimal
  return 1
}

# Nach Fehlstarts (xstart): XLibre-Pakete neu installieren
xserver_repair() {
  xlibre_repo
  xbps-install -S >/dev/null 2>&1 || echo "Paketquelle nicht erreichbar – versuche es mit dem Zwischenspeicher"
  xbps-install -fy xlibre-minimal xlibre-xserver xinit xauth && echo "XLibre neu installiert."
}

# ---------------------------------------------------------------------
#  Paketquelle: schnellsten Tier-1-Mirror von Void waehlen
# ---------------------------------------------------------------------
# Void liefert repo-default.voidlinux.org – ein Name, der auf irgendeinen Tier-1-Mirror zeigen kann, auch auf einen
# gerade ueberlasteten (27.10.2026: Helsinki lieferte 270 KB/s bzw. gar nichts, der Sync hing 5 Minuten).
# Darum messen wir die Tier-1-Mirrors (https://xmirror.voidlinux.org) und tragen den schnellsten in /etc/xbps.d ein:
# je Void-Repo-Datei aus /usr/share/xbps.d eine gleichnamige Datei (die in /etc gehen vor), nur der Server getauscht.
# Eigene Einstellungen bleiben: Liegt in /etc/xbps.d eine Paketquelle, die kein Tier-1-Mirror ist (oder eine
# selbst angelegte Datei), fasst VoidStation nichts an. Gemessen wird beim Update immer, bei der Update-Pruefung
# hoechstens einmal am Tag und sofort, wenn das Laden der Paketlisten scheitert oder haengt.
MIRROR_STATE=/usr/local/share/voidstation/mirror        # "<Zeitpunkt> <Basis-Adresse> <Bytes/s>"
MIRROR_DEFAULT=https://repo-default.voidlinux.org
MIRRORS="https://repo-de.voidlinux.org https://repo-fastly.voidlinux.org https://repo-fi.voidlinux.org https://mirrors.summithq.com/voidlinux"
MIRROR_MARK="# VoidStation: Paketquelle automatisch gewaehlt (voidstation-pkg mirror) – wird bei Bedarf neu geschrieben"

mirror_tier1() {   # $1 = Adresse; zeigt sie auf einen Tier-1-Mirror (oder repo-default)?
  for b in $MIRROR_DEFAULT $MIRRORS; do
    case "$1" in "$b"/*) return 0 ;; esac
  done
  return 1
}

mirror_files() {   # Void-Repo-Dateien (nur Namen), z. B. 00-repository-main.conf, 10-repository-nonfree.conf
  for f in /usr/share/xbps.d/*-repository-*.conf; do
    [ -f "$f" ] && echo "${f##*/}"
  done
}

mirror_custom() {  # eigene Paketquelle in /etc/xbps.d? Gibt die Datei aus.
  for f in /etc/xbps.d/*.conf; do
    [ -f "$f" ] || continue
    n="${f##*/}"
    [ "$n" = 99-repository-xlibre.conf ] && continue
    urls="$(sed -n 's/^[[:space:]]*repository[[:space:]]*=[[:space:]]*\([^[:space:]]*\).*/\1/p' "$f")"
    [ -n "$urls" ] || continue
    for u in $urls; do
      mirror_tier1 "$u" || { echo "$n"; return 0; }
    done
    [ -f "/usr/share/xbps.d/$n" ] || { echo "$n"; return 0; }   # selbst angelegte Datei mit Tier-1-Adresse
  done
  return 1
}

mirror_name() { echo "$1" | sed -e 's#^https://##' -e 's#/.*##'; }

mirror_apply() {   # $1 = Basis-Adresse: alle Void-Repo-Dateien auf diesen Server stellen
  base="$1"
  mirror_tier1 "$base/x" || return 1
  mkdir -p /etc/xbps.d
  script="$(for b in $MIRROR_DEFAULT $MIRRORS; do
    printf 's#^\\([[:space:]]*repository[[:space:]]*=[[:space:]]*\\)%s/#\\1%s/#\n' "$b" "$base"
  done)"
  for n in $(mirror_files); do
    tmp="/etc/xbps.d/.$n.vs-tmp"
    { echo "$MIRROR_MARK"; sed "$script" "/usr/share/xbps.d/$n"; } > "$tmp" || { rm -f "$tmp"; return 1; }
    if cmp -s "$tmp" "/etc/xbps.d/$n"; then rm -f "$tmp"; continue; fi
    chmod 644 "$tmp" && mv -f "$tmp" "/etc/xbps.d/$n"
  done
}

mirror_measure() { # je Mirror "<Bytes/s> <Basis-Adresse>", schnellster zuerst (gemessen parallel, hoechstens 10 s)
  arch="$(xbps-uhelper arch 2>/dev/null)"; [ -n "$arch" ] || arch="$(uname -m)"
  case "$arch" in *-musl) path="current/musl/$arch-repodata" ;; *) path="current/$arch-repodata" ;; esac
  d="$(mktemp -d /tmp/voidstation-mirror.XXXXXX)" || return 1
  i=0
  for b in $MIRRORS; do
    i=$((i + 1))
    ( r="$(curl -s -o /dev/null --proto '=https' --connect-timeout 4 -m 10 \
             -w '%{http_code} %{size_download} %{speed_download}' "$b/$path" 2>/dev/null)"
      echo "${r:-000 0 0} $b" > "$d/$i" ) &
  done
  wait
  cat "$d"/* 2>/dev/null | awk '{ s = ($1 == 200 && $2 > 100000) ? int($3) : 0; print s, $4 }' | sort -rn
  rm -rf "$d"
}

mirror_auto() {    # [now]: jetzt messen (sonst hoechstens einmal am Tag); Ausgabe nur, wenn gemessen wurde
  [ -e /etc/voidstation-live ] && return 0
  [ -n "$(mirror_files)" ] || return 0
  mirror_custom >/dev/null && return 0
  last=0; cur=""
  [ -f "$MIRROR_STATE" ] && read -r last cur _ < "$MIRROR_STATE"
  case "$last" in ""|*[!0-9]*) last=0 ;; esac
  mirror_tier1 "$cur/x" || cur=""
  now="$(date +%s)"
  if [ "$1" != now ] && [ -n "$cur" ] && [ $((now - last)) -lt 86400 ]; then
    mirror_apply "$cur"              # neu hinzugekommene Repos (z. B. multilib fuer Steam) gleich mit umstellen
    return 0
  fi
  command -v curl >/dev/null 2>&1 || { [ -n "$cur" ] && mirror_apply "$cur"; return 0; }
  res="$(mirror_measure)"
  best="$(echo "$res" | awk 'NR == 1 { print $2 }')"
  bs="$(echo "$res" | awk 'NR == 1 { print $1 + 0 }')"
  echo "Paketquelle: Mirrors gemessen –$(echo "$res" | awk '{ n = $2; sub("^https://", "", n); sub("/.*", "", n); printf " %s %.1f MB/s;", n, $1 / 1048576 }' | sed 's/;$//')"
  if [ -z "$best" ] || [ "${bs:-0}" -lt 51200 ]; then   # unter 50 KB/s: offline oder alles gestoert – nichts aendern
    echo "Paketquelle: kein Mirror brauchbar erreichbar – bleibt bei $(mirror_name "${cur:-$MIRROR_DEFAULT}")"
    [ -n "$cur" ] && mirror_apply "$cur"
    return 1
  fi
  if [ -n "$cur" ] && [ "$cur" != "$best" ]; then
    # Der bisherige bleibt, wenn er mindestens 70 % des schnellsten schafft (kein Hin und Her bei kleinen Unterschieden)
    cs="$(echo "$res" | awk -v b="$cur" '$2 == b { print $1 + 0 }')"
    if [ -n "$cs" ] && [ "$cs" -ge $((bs * 7 / 10)) ]; then best="$cur"; bs="$cs"; fi
  fi
  mirror_apply "$best" || return 1
  echo "$now $best $bs" > "$MIRROR_STATE"; chmod 644 "$MIRROR_STATE"
  echo "Paketquelle: $(mirror_name "$best")"
}

mirror_status() {
  if c="$(mirror_custom)"; then echo "eigene Paketquelle ($c) – VoidStation waehlt keinen Mirror"; return 0; fi
  if [ -f "$MIRROR_STATE" ]; then
    read -r last cur bs < "$MIRROR_STATE"
    echo "Mirror: $(mirror_name "$cur") ($(awk -v s="${bs:-0}" 'BEGIN { printf "%.1f MB/s", s / 1048576 }'), gemessen $(date -d "@$last" '+%d.%m.%Y %H:%M' 2>/dev/null))"
  else
    echo "Mirror: Void-Vorgabe ($(mirror_name "$MIRROR_DEFAULT")), noch nicht gemessen"
  fi
}

# Paketlisten laden, hoechstens 90 s je Versuch; haengt oder scheitert es, neu messen und noch einmal
repo_sync() {
  timeout -k 5 90 xbps-install -S && return 0
  echo "Paketlisten nicht geladen – suche einen anderen Mirror …"
  mirror_auto now
  timeout -k 5 90 xbps-install -S && return 0
  echo "Paketquelle antwortet nicht – bitte spaeter noch einmal versuchen"
  return 1
}

# ---------------------------------------------------------------------
#  Fernzugriff (SSH) an/aus
# ---------------------------------------------------------------------
ssh_ctl() {
  case "$1" in
    on)
      [ -d /etc/sv/sshd ] || xbps-install -Sy openssh || return 1
      [ -e /var/service/sshd ] || ln -s /etc/sv/sshd /var/service/
      echo "SSH an"
      ;;
    off) rm -f /var/service/sshd; echo "SSH aus" ;;
    status|"") [ -e /var/service/sshd ] && echo on || echo off ;;
    *) echo "ssh: on | off | status"; return 2 ;;
  esac
}

kernel_purge() {
  # Alte Kernel entfernen – nur, wenn gerade der neueste installierte Kernel laeuft (der Aufrufer
  # wartet zusaetzlich, bis die Oberflaeche eine Weile stabil laeuft). Prueft hier selbst noch einmal.
  command -v vkpurge >/dev/null 2>&1 || { echo "vkpurge fehlt – nichts entfernt"; return 0; }
  run="$(uname -r)"
  newest=""
  for d in /usr/lib/modules/*/; do
    v="${d%/}"; v="${v##*/}"
    [ -f "/boot/vmlinuz-$v" ] && newest="$(printf '%s\n%s\n' "$newest" "$v" | grep . | sort -V | tail -1)"
  done
  if [ -z "$newest" ] || [ "$newest" != "$run" ]; then
    echo "laeuft nicht mit dem neuesten Kernel ($run, neuester: ${newest:-?}) – nichts entfernt"; return 0
  fi
  if pgrep -x 'xbps-install|xbps-remove|xbps-reconfigure' >/dev/null 2>&1; then
    echo "xbps laeuft gerade – spaeter"; return 1
  fi
  old="$(vkpurge list 2>/dev/null | grep -vx "$run")"
  [ -n "$old" ] || { echo "keine alten Kernel"; return 0; }
  for v in $old; do
    echo "entferne Kernel $v"
    vkpurge rm "$v" || { echo "Kernel $v konnte nicht entfernt werden"; return 1; }
  done
}

main() {
  cmd="$1"; [ $# -gt 0 ] && shift
  case "$cmd" in
    install)
      check_pkgs "$@" || return $?
      mirror_auto
      xbps-install -Sy "$@"
      ;;
    remove)
      check_pkgs "$@" || return $?
      xbps-remove -Ry "$@" || return $?
      xbps-remove -oy || true               # nicht mehr benoetigte Abhaengigkeiten aufraeumen
      ;;
    markauto)                               # als "automatisch installiert" markieren (fuer spaeteres Aufraeumen)
      check_pkgs "$@" || return $?
      xbps-pkgdb -m auto "$@"
      ;;
    sync)                                   # z. B. nach neuen Repos (multilib fuer Steam): die gleich mit umstellen
      mirror_auto
      repo_sync
      ;;
    update)
      mirror_auto now                       # vor jedem Update den schnellsten Mirror suchen (dauert hoechstens 10 s)
      repo_sync || return 1
      xbps-install -yu xbps || true         # xbps muss sich ggf. zuerst selbst aktualisieren
      xbps-install -yu
      ;;
    check)                                  # ausstehende Paket-Updates auflisten (--nosync: ohne Paketlisten zu laden)
      synced=1
      if [ "$1" != "--nosync" ]; then
        mirror_auto >/dev/null 2>&1
        repo_sync >/dev/null 2>&1 || synced=0
      fi
      out="$(xbps-install -un 2>&1)"; rc=$?
      case "$out" in
        *"must be updated"*) xbps-install -un xbps 2>/dev/null; return 0 ;;   # erst xbps selbst, danach der Rest
      esac
      [ -n "$out" ] && printf '%s\n' "$out"
      if [ "$synced" = 0 ]; then              # Stand der alten Paketlisten; letzte Zeile = Fehlermeldung fuer den Launcher
        echo "Paketquelle antwortet nicht" >&2
        return 3
      fi
      return $rc
      ;;
    mirror)                                 # Paketquelle: status | auto (jetzt messen)
      case "$1" in
        auto) mirror_auto now ;;
        status|"") mirror_status ;;
        *) echo "mirror: status | auto"; return 2 ;;
      esac
      ;;
    selfupdate)
      selfupdate
      ;;
    xserver)                                # Grafik-Server: nur XLibre
      case "$1" in
        ensure|auto|xlibre) xserver_ensure ;;
        repair) xserver_repair ;;
        status|"") if xlibre_ok; then echo "aktiv: xlibre"; else echo "aktiv: kein XLibre"; fi
                   xorg_left && echo "Hinweis: X.Org noch installiert (wird beim naechsten Update ersetzt)"; return 0 ;;
        *) echo "xserver: ensure | repair | status"; return 2 ;;
      esac
      ;;
    ssh)                                    # Fernzugriff: on | off | status
      ssh_ctl "$1"
      ;;
    bluetooth)                              # Bluetooth-Dienst: on | off | status
      bluetooth_ctl "$1"
      ;;
    suspend)                                # Standby (Weckquellen: sysfix.sh, Abschnitt 6)
      suspend_now
      ;;
    kernelpurge)                            # alte Kernel weg, wenn der neueste laeuft
      kernel_purge
      ;;
    channel)                                # Update-Kanal waehlen: stable (Standard) oder main (Test)
      case "$1" in stable|main) echo "$1" > "$CHANNELFILE"; chmod 644 "$CHANNELFILE"; echo "Kanal: $1" ;;
        *) echo "Kanal muss stable oder main sein"; return 2 ;; esac
      ;;
    *)
      echo "Benutzung: voidstation-pkg install|remove|markauto <paket>... | sync | update | check [--nosync] | mirror status|auto | selfupdate | kernelpurge | channel stable|main | xserver ensure|repair|status | ssh on|off|status | bluetooth on|off|status | suspend"
      return 2
      ;;
  esac
}

main "$@"
exit $?
