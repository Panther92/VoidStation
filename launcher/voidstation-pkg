#!/bin/sh
# SPDX-License-Identifier: GPL-3.0-or-later
# voidstation-pkg – kleiner Root-Helfer fuer das AppCenter.
# Darf per sudo ohne Passwort laufen, installiert/entfernt aber NUR Pakete
# aus der Freigabeliste, fuehrt System-Updates aus und aktualisiert
# VoidStation selbst – immer aus der fest hinterlegten Quelle
# (/usr/local/share/voidstation/update-url, gehoert root), nie aus einer
# Datei, die der Benutzer vorgibt.
#
# Alles steckt in main(): die Shell liest die Funktion komplett ein, bevor
# sie laeuft. So stoert es nicht, wenn das Selbst-Update diese Datei ersetzt.

ALLOW=/usr/local/share/voidstation/allowed-packages
URLFILE=/usr/local/share/voidstation/update-url
CHANNELFILE=/usr/local/share/voidstation/channel
SIGNERS=/usr/local/share/voidstation/allowed_signers
XCHOICE=/usr/local/share/voidstation/xserver         # frueher: Wahl XLibre/X.Org (wird entfernt)
XLIBRE_REPO=https://github.com/xlibre-void/xlibre/releases/latest/download
XLIBRE_KEYFP=00:ca:42:57:c9:c0:9a:ec:94:b4:7d:97:e5:a9:aa:1e
export LC_ALL=C

check_pkgs() {
  [ $# -gt 0 ] || { echo "kein Paket angegeben"; return 2; }
  for pkg in "$@"; do
    case "$pkg" in *[!A-Za-z0-9._+-]*|"") echo "ungueltiger Paketname: $pkg"; return 2 ;; esac
    grep -qx "$pkg" "$ALLOW" 2>/dev/null || { echo "nicht freigegeben: $pkg"; return 2; }
  done
}

update_url() {
  ch="$(head -n1 "$CHANNELFILE" 2>/dev/null)"
  case "$ch" in stable|main) ;; *) ch=stable ;; esac
  head -n1 "$URLFILE" 2>/dev/null | sed "s/{channel}/$ch/"
}

selfupdate() {
  url="$(update_url)"
  case "$url" in https://*) ;; *) echo "keine gueltige Update-Adresse in $URLFILE"; return 2 ;; esac
  user="${SUDO_USER:-}"
  case "$user" in ""|root|*[!a-z0-9_-]*) echo "Selbst-Update nur per sudo von einem normalen Benutzer"; return 2 ;; esac
  command -v curl >/dev/null 2>&1 || xbps-install -Sy curl >/dev/null 2>&1
  tmp="$(mktemp -d /tmp/voidstation-update.XXXXXX)" || return 1   # gehoert root, 0700
  echo "Lade $url/update.sh"
  if ! curl -fsSL --proto '=https' --tlsv1.2 --retry 2 -o "$tmp/update.sh" "$url/update.sh"; then
    echo "Download fehlgeschlagen"; rm -rf "$tmp"; return 1
  fi
  if [ "$(head -c 11 "$tmp/update.sh")" != '#!/bin/bash' ] || ! grep -q '^__PAYLOAD_BELOW__$' "$tmp/update.sh"; then
    echo "Unerwarteter Inhalt – Update abgebrochen"; rm -rf "$tmp"; return 1
  fi
  if [ -s "$SIGNERS" ]; then
    # Nur Updates mit gueltiger Signatur des Herausgebers werden ausgefuehrt
    if ! curl -fsSL --proto '=https' --tlsv1.2 --retry 2 -o "$tmp/update.sh.sig" "$url/update.sh.sig"; then
      echo "Signatur fehlt – Update abgelehnt"; rm -rf "$tmp"; return 1
    fi
    if ! ssh-keygen -Y verify -f "$SIGNERS" -I voidstation-release -n voidstation \
         -s "$tmp/update.sh.sig" < "$tmp/update.sh" >/dev/null 2>&1; then
      echo "Signatur UNGUELTIG – Update abgelehnt"; rm -rf "$tmp"; return 1
    fi
    echo "Signatur geprueft: ok"
  else
    echo "Hinweis: noch kein Signaturschluessel hinterlegt – Update ohne Signaturpruefung"
  fi
  VSUSER="$user" SUDO_USER="$user" VOIDSTATION_NONINTERACTIVE=1 bash "$tmp/update.sh" </dev/null
  rc=$?
  rm -rf "$tmp"
  return $rc
}

# ---------------------------------------------------------------------
#  Bluetooth-Dienst (bluetoothd) an/aus
# ---------------------------------------------------------------------
bluetooth_ctl() {
  case "$1" in
    on)
      [ -d /etc/sv/bluetoothd ] || xbps-install -Sy bluez || return 1
      [ -e /var/service/bluetoothd ] || ln -s /etc/sv/bluetoothd /var/service/
      echo "Bluetooth an"
      ;;
    off) rm -f /var/service/bluetoothd; echo "Bluetooth aus" ;;
    status|"") [ -e /var/service/bluetoothd ] && echo on || echo off ;;
    *) echo "bluetooth: on | off | status"; return 2 ;;
  esac
}

# ---------------------------------------------------------------------
#  Grafik-Server: ausschliesslich XLibre (Pakete von xlibre-void)
# ---------------------------------------------------------------------
xlibre_key() {   # Signaturschluessel des xlibre-void-Repos (Fingerabdruck geprueft: 00:ca:42:57:…)
  cat <<'KEYEOF'
<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple Computer//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>public-key</key>
	<data></data>
	<key>public-key-size</key>
	<integer>2048</integer>
	<key>signature-by</key>
	<string>xlibre-github-actions</string>
</dict>
</plist>
KEYEOF
}

xlibre_repo() {   # Paketquelle + fest hinterlegter Schluessel
  mkdir -p /etc/xbps.d /var/db/xbps/keys
  xlibre_key > "/var/db/xbps/keys/$XLIBRE_KEYFP.plist"
  echo "repository=$XLIBRE_REPO" > /etc/xbps.d/99-repository-xlibre.conf
}
xlibre_ok() { xbps-query xlibre-xserver >/dev/null 2>&1; }
xorg_left() { xbps-query xorg-server >/dev/null 2>&1 || xbps-query xorg-minimal >/dev/null 2>&1; }
xorg_cleanup() {
  xbps-query xorg-minimal >/dev/null 2>&1 && xbps-remove -Ry xorg-minimal
  xbps-query xorg-server  >/dev/null 2>&1 && xbps-remove -Fy xorg-server
  return 0
}

# XLibre sicherstellen; ersetzt ein noch vorhandenes X.Org (Geraete von vor 0.7.0)
xserver_ensure() {
  rm -f "$XCHOICE"                       # fruehere Wahl XLibre/X.Org gibt es nicht mehr
  xlibre_repo
  if xlibre_ok && ! xorg_left; then echo "XLibre ist aktiv."; return 0; fi
  echo "Lade Paketlisten (XLibre) …"
  if ! xbps-install -S >/dev/null || ! xbps-query -R xlibre-minimal >/dev/null 2>&1; then
    echo "XLibre-Paketquelle nicht erreichbar."
    xlibre_ok && return 0
    return 1
  fi
  if xlibre_ok; then echo "Entferne X.Org-Reste …"; xorg_cleanup; echo "XLibre ist aktiv."; return 0; fi
  # Erst alles herunterladen, dann tauschen – scheitert der Download, bleibt alles wie es ist
  echo "Lade XLibre herunter …"
  if ! xbps-install -Dy xlibre-minimal xinit xauth >/dev/null; then echo "Download fehlgeschlagen – nichts geaendert."; return 1; fi
  xorg_left && xbps-install -Dfy xorg-minimal >/dev/null 2>&1   # nur fuer den Notfall im Zwischenspeicher
  echo "Entferne X.Org …"
  xorg_cleanup
  echo "Installiere XLibre …"
  if xbps-install -y xlibre-minimal xinit xauth && xlibre_ok; then
    echo "XLibre installiert – aktiv ab dem naechsten Neustart."
    return 0
  fi
  # Ohne jeden X-Server gaebe es keine Oberflaeche mehr: vorlaeufig X.Org zurueck, naechstes Update versucht es erneut
  echo "XLibre-Installation fehlgeschlagen – X.Org bleibt vorlaeufig installiert."
  xbps-install -y xorg-minimal >/dev/null 2>&1 || xbps-install -Sy xorg-minimal
  return 1
}

# Nach Fehlstarts (xstart): XLibre-Pakete neu installieren
xserver_repair() {
  xlibre_repo
  xbps-install -S >/dev/null 2>&1 || echo "Paketquelle nicht erreichbar – versuche es mit dem Zwischenspeicher"
  xbps-install -fy xlibre-minimal xlibre-xserver xinit xauth && echo "XLibre neu installiert."
}

# ---------------------------------------------------------------------
#  Fernzugriff (SSH) an/aus
# ---------------------------------------------------------------------
ssh_ctl() {
  case "$1" in
    on)
      [ -d /etc/sv/sshd ] || xbps-install -Sy openssh || return 1
      [ -e /var/service/sshd ] || ln -s /etc/sv/sshd /var/service/
      echo "SSH an"
      ;;
    off) rm -f /var/service/sshd; echo "SSH aus" ;;
    status|"") [ -e /var/service/sshd ] && echo on || echo off ;;
    *) echo "ssh: on | off | status"; return 2 ;;
  esac
}

main() {
  cmd="$1"; [ $# -gt 0 ] && shift
  case "$cmd" in
    install)
      check_pkgs "$@" || return $?
      xbps-install -Sy "$@"
      ;;
    remove)
      check_pkgs "$@" || return $?
      xbps-remove -Ry "$@" || return $?
      xbps-remove -oy || true               # nicht mehr benoetigte Abhaengigkeiten aufraeumen
      ;;
    markauto)                               # als "automatisch installiert" markieren (fuer spaeteres Aufraeumen)
      check_pkgs "$@" || return $?
      xbps-pkgdb -m auto "$@"
      ;;
    sync)
      xbps-install -S
      ;;
    update)
      xbps-install -Syu xbps || true        # xbps muss sich ggf. zuerst selbst aktualisieren
      xbps-install -Syu
      ;;
    check)
      xbps-install -S >/dev/null 2>&1
      xbps-install -un
      ;;
    selfupdate)
      selfupdate
      ;;
    xserver)                                # Grafik-Server: nur XLibre
      case "$1" in
        ensure|auto|xlibre) xserver_ensure ;;
        repair) xserver_repair ;;
        status|"") if xlibre_ok; then echo "aktiv: xlibre"; else echo "aktiv: kein XLibre"; fi
                   xorg_left && echo "Hinweis: X.Org noch installiert (wird beim naechsten Update ersetzt)"; return 0 ;;
        *) echo "xserver: ensure | repair | status"; return 2 ;;
      esac
      ;;
    ssh)                                    # Fernzugriff: on | off | status
      ssh_ctl "$1"
      ;;
    bluetooth)                              # Bluetooth-Dienst: on | off | status
      bluetooth_ctl "$1"
      ;;
    channel)                                # Update-Kanal waehlen: stable (Standard) oder main (Test)
      case "$1" in stable|main) echo "$1" > "$CHANNELFILE"; chmod 644 "$CHANNELFILE"; echo "Kanal: $1" ;;
        *) echo "Kanal muss stable oder main sein"; return 2 ;; esac
      ;;
    *)
      echo "Benutzung: voidstation-pkg install|remove|markauto <paket>... | sync | update | check | selfupdate | channel stable|main | xserver ensure|repair|status | ssh on|off|status | bluetooth on|off|status"
      return 2
      ;;
  esac
}

main "$@"
exit $?
