#!/bin/sh
# SPDX-License-Identifier: GPL-3.0-or-later
# =====================================================================
#  VoidStation: Startbild beim Hochfahren (Plymouth, Theme "voidstation") auf installierten Geraeten
#
#  Ablauf beim Start:
#   1. Initramfs: Plymouth zeichnet das Logo ueber den Bildschirmspeicher der Firmware (efifb). Die grossen
#      Grafiktreiber (amdgpu, i915, nouveau, nvidia …) sind absichtlich nicht im Initramfs (Platz auf der
#      EFI-Partition, s. dracut-voidstation.conf) – das Logo steht trotzdem sofort, ohne Textmeldungen.
#   2. Nach udev (Core-Service 02-voidstation-splash.sh): Der richtige Treiber hat den Bildschirm
#      uebernommen. Plymouth 22.02 (Void) kann einen neuen Bildschirm im laufenden Skript-Theme nicht
#      uebernehmen (kam erst 2023) – darum startet es hier einmal frisch auf dem neuen Treiber.
#   3. Vor Stufe 2 (Core-Service 99-voidstation-splash.sh): Plymouth endet, das Logo bleibt stehen,
#      bis X und die Startseite (gleiches Logo) uebernehmen.
#
#  Aufruf (root):
#    voidstation-splash setup [--theme DIR] [--no-rebuild]
#        einrichten (install.sh, update.sh, Installer), beliebig oft ausfuehrbar. Baut das Initramfs neu,
#        wenn sich etwas geaendert hat. Rueckgabe: 0 fertig, 2 Initramfs muss noch neu gebaut werden
#        (im chroot oder mit --no-rebuild; danach "voidstation-splash stamp"), 1 Fehler
#    voidstation-splash off | on     Startbild ab- bzw. wieder einschalten (bleibt bei Updates so)
#    voidstation-splash status       Stand anzeigen
#    voidstation-splash stamp        Stand als "im Initramfs" vermerken (nach einem Neubau von aussen)
#    voidstation-splash boot-drm | boot-quit   nur fuer die Core-Services beim Start
#  Nur x86_64 bekommt Plymouth (die 32-Bit-ISO laesst es weg); ohne das Paket tut setup nichts.
# =====================================================================
R="${VS_SPLASH_ROOT:-}"                       # nur fuer Tests: anderes Wurzelverzeichnis
THEME="voidstation"
THEME_DIR="$R/usr/share/plymouth/themes/$THEME"
PCONF="$R/etc/plymouth/plymouthd.conf"
DMAIN="$R/etc/dracut.conf.d/10-voidstation.conf"
DOFF="$R/etc/dracut.conf.d/20-voidstation-splash.conf"   # an: grosse Grafiktreiber raus, aus: Plymouth raus
CORE_DIR="$R/etc/runit/core-services"
VSD="$R/usr/local/share/voidstation"
OFF="$VSD/splash-off"
BUILT="$VSD/splash-built"
EFICONF="$R/etc/default/voidstation-efistub"
GRUBDEF="$R/etc/default/grub"
CHROOT="${VOIDSTATION_CHROOT:-0}"
# Grafiktreiber, die nicht im Initramfs stecken (omit_drivers in dracut-voidstation.conf): haengt der
# Bildschirm nach udev an einem davon, zeichnete Plymouth bis dahin auf efifb und muss neu starten
LATE_DRIVERS="amdgpu radeon nouveau i915 xe nvidia nova_drm"

say()  { printf '%s\n' "$*"; }
warn() { printf 'voidstation-splash: %s\n' "$*" >&2; }

have_plymouth() { [ -x "$R/usr/bin/plymouthd" ] || [ -x "$R/usr/sbin/plymouthd" ]; }
is_live() { [ -e "$R/etc/voidstation-live" ] || [ "${VOIDSTATION_LIVE:-0}" = 1 ]; }

# Text $1 mit Wort $2 (1) bzw. ohne Wort $2 (0); Reihenfolge der uebrigen Woerter bleibt
words_set() {
  _out=""; _found=0
  set -f
  for _w in $1; do
    if [ "$_w" = "$2" ]; then
      # entfernen: nie behalten; hinzufuegen: nur das erste Vorkommen behalten
      if [ "$3" != 1 ] || [ "$_found" = 1 ]; then _found=1; continue; fi
      _found=1
    fi
    _out="${_out:+$_out }$_w"
  done
  set +f
  [ "$3" = 1 ] && [ "$_found" = 0 ] && _out="${_out:+$_out }$2"
  printf '%s' "$_out"
}
# Wert einer Zeile NAME="..." (nur doppelte Anfuehrungszeichen); leer, wenn die Zeile fehlt
getval() { sed -n "s/^$2=\"\(.*\)\"[[:space:]]*\$/\1/p" "$1" 2>/dev/null | head -n1; }
hasline() { grep -q "^$2=\"" "$1" 2>/dev/null; }
# Zeile NAME="WERT" setzen (ersetzt die erste vorhandene, sonst anhaengen)
setline() {
  awk -v n="$2" -v v="$3" '
    !done && index($0, n "=") == 1 { print n "=\"" v "\""; done = 1; next }
    { print }
    END { if (!done) print n "=\"" v "\"" }' "$1" > "$1.vs-new" && cat "$1.vs-new" > "$1"
  rm -f "$1.vs-new"
}
# Datei nur schreiben, wenn sich der Inhalt aendert (Inhalt auf stdin)
put() {
  _t="$1.vs-new"
  cat > "$_t" || { rm -f "$_t"; return 1; }
  if cmp -s "$_t" "$1"; then rm -f "$_t"; return 1; fi
  chmod "${2:-644}" "$_t" && mv -f "$_t" "$1"
}

# Neuester vollstaendiger Kernel (wie voidstation-efistub)
newest_kernel() {
  _kv=""
  for _f in $(ls "$R"/boot/vmlinuz-* 2>/dev/null | sort -V); do
    _v="${_f##*/vmlinuz-}"
    [ -d "$R/usr/lib/modules/$_v" ] && _kv="$_v"
  done
  printf '%s' "$_kv"
}

# Pruefsumme ueber alles, was im Initramfs landet bzw. es beeinflusst
state_sum() {
  {
    echo "on=$1"
    cat "$PCONF" "$DMAIN" "$DOFF" 2>/dev/null
    for _f in "$THEME_DIR"/*; do [ -f "$_f" ] && cat "$_f"; done
  } | cksum | cut -d' ' -f1
}
enabled() { have_plymouth && [ -s "$THEME_DIR/$THEME.plymouth" ] && [ ! -e "$OFF" ]; }

# ---------------------------------------------------------------------
# Beim Start (aus den Core-Services, als root, Wurzel noch schreibgeschuetzt)
boot_drm() {
  grep -qw splash /proc/cmdline 2>/dev/null || return 0
  command -v plymouthd >/dev/null 2>&1 || return 0
  late=0; card=0
  for c in /sys/class/drm/card[0-9]*; do
    [ -e "$c/device/driver" ] || continue
    card=1
    d="$(basename "$(readlink "$c/device/driver")")"
    for l in $LATE_DRIVERS; do [ "$d" = "$l" ] && late=1; done
  done
  [ "$card" = 1 ] || return 0                    # kein Grafiktreiber: Plymouth bleibt, wie es ist
  if plymouth --ping 2>/dev/null; then
    [ "$late" = 1 ] || return 0                  # zeichnet schon auf dem richtigen Treiber
    timeout 5 plymouth quit --retain-splash 2>/dev/null || pkill -x plymouthd 2>/dev/null
    i=0
    while plymouth --ping 2>/dev/null && [ "$i" -lt 30 ]; do sleep 0.1; i=$((i + 1)); done
  fi
  # Konsole leeren und Schreibmarke aus – falls zwischen den beiden Plymouth kurz Text zu sehen ist
  printf '\033[2J\033[H\033[?25l' > /dev/console 2>/dev/null
  mkdir -p /run/plymouth
  plymouthd --mode=boot --pid-file=/run/plymouth/pid 2>/dev/null && plymouth show-splash 2>/dev/null
  return 0
}

boot_quit() {
  command -v plymouth >/dev/null 2>&1 || return 0
  plymouth --ping 2>/dev/null || return 0
  # --retain-splash: das Logo bleibt stehen, bis X uebernimmt (sonst kurz die Textkonsole)
  timeout 5 plymouth quit --retain-splash 2>/dev/null || pkill -x plymouthd 2>/dev/null
  return 0
}

# ---------------------------------------------------------------------
write_core_services() {
  mkdir -p "$CORE_DIR"
  put "$CORE_DIR/02-voidstation-splash.sh" <<'EOF'
# SPDX-License-Identifier: GPL-3.0-or-later
# VoidStation (runit core-service, nach udev): Startbild auf den richtigen Grafiktreiber holen.
# Bis hierher zeichnet Plymouth ueber den Bildschirmspeicher der Firmware (efifb), s. voidstation-splash.
[ -x /usr/local/sbin/voidstation-splash ] && /usr/local/sbin/voidstation-splash boot-drm
EOF
  put "$CORE_DIR/99-voidstation-splash.sh" <<'EOF'
# SPDX-License-Identifier: GPL-3.0-or-later
# VoidStation (runit core-service, zuletzt): Startbild beenden, bevor X startet – sonst haelt es den Bildschirm.
# Das Logo bleibt stehen, bis die Oberflaeche uebernimmt. Abschalten: sudo voidstation-splash off
[ -x /usr/local/sbin/voidstation-splash ] && /usr/local/sbin/voidstation-splash boot-quit
EOF
  return 0
}

# Kernel-Befehlszeile: "splash" fuer EFISTUB und GRUB (nur dann zeigt Plymouth das Logo statt Text)
CMD_EFI=0; CMD_GRUB=0
set_cmdline() {
  if [ -f "$EFICONF" ] && hasline "$EFICONF" OPTIONS; then
    old="$(getval "$EFICONF" OPTIONS)"
    new="$(words_set "$old" splash "$1")"
    if [ "$new" != "$old" ]; then
      setline "$EFICONF" OPTIONS "$new"; CMD_EFI=1
      say "EFISTUB: $new"
    fi
  fi
  if [ -f "$GRUBDEF" ]; then
    old="$(getval "$GRUBDEF" GRUB_CMDLINE_LINUX_DEFAULT)"
    if hasline "$GRUBDEF" GRUB_CMDLINE_LINUX_DEFAULT || [ "$1" = 1 ]; then
      new="$(words_set "$old" splash "$1")"
      if [ "$new" != "$old" ] || ! hasline "$GRUBDEF" GRUB_CMDLINE_LINUX_DEFAULT; then
        setline "$GRUBDEF" GRUB_CMDLINE_LINUX_DEFAULT "$new"; CMD_GRUB=1
        say "GRUB: GRUB_CMDLINE_LINUX_DEFAULT=\"$new\""
      fi
    fi
  fi
}

rebuild() {
  kv="$(newest_kernel)"
  [ -n "$kv" ] || { warn "kein Kernel unter /boot – Initramfs nicht neu gebaut"; return 1; }
  say "Initramfs fuer Kernel $kv wird neu erzeugt (dauert etwas) ..."
  # baut das Initramfs und ruft die Kernel-Hooks auf (EFISTUB auf die EFI-Partition, GRUB-Menue)
  if ! xbps-reconfigure -f "linux$(echo "$kv" | cut -d. -f1-2)" >/dev/null 2>&1 || [ ! -s "$R/boot/initramfs-$kv.img" ]; then
    warn "Initramfs fuer $kv konnte nicht erzeugt werden"
    return 1
  fi
  say "Initramfs: $(( $(stat -c %s "$R/boot/initramfs-$kv.img" 2>/dev/null || echo 0) / 1048576 )) MB"
  return 0
}

apply_boot() {   # Befehlszeile und Kernel auf die EFI-Partition bzw. ins GRUB-Menue
  if [ -f "$EFICONF" ] && [ -x /usr/local/sbin/voidstation-efistub ]; then
    /usr/local/sbin/voidstation-efistub || warn "voidstation-efistub meldet einen Fehler"
    df -h /boot/efi 2>/dev/null | awk 'NR == 2 { print "EFI-Partition: " $4 " frei" }'
  fi
  if [ "$CMD_GRUB" = 1 ] && [ -f /boot/grub/grub.cfg ]; then
    update-grub >/dev/null 2>&1 || grub-mkconfig -o /boot/grub/grub.cfg >/dev/null 2>&1 || warn "GRUB-Menue nicht erneuert"
  fi
}

setup() {
  theme_src=""; norebuild=0
  while [ $# -gt 0 ]; do
    case "$1" in
      --theme) theme_src="${2:-}"; shift ;;
      --no-rebuild) norebuild=1 ;;
      *) warn "unbekannte Angabe: $1"; return 1 ;;
    esac
    shift
  done
  if is_live; then
    say "Startbild: Live-System – richtet der ISO-Bau ein"
    return 0
  fi
  write_core_services
  if ! have_plymouth; then
    # ohne Plymouth (32 Bit) kein "splash" – sonst bliebe die Zeile auch nach dem Entfernen stehen
    set_cmdline 0
    rm -f "$DOFF"
    if [ "$CHROOT" != 1 ] && { [ "$CMD_EFI" = 1 ] || [ "$CMD_GRUB" = 1 ]; }; then apply_boot; fi
    return 0
  fi
  # Theme (Logo, Punkte, Skript) aus den VoidStation-Dateien
  if [ -n "$theme_src" ]; then
    if [ -s "$theme_src/$THEME.plymouth" ]; then
      mkdir -p "$THEME_DIR"
      for f in "$theme_src"/*; do
        [ -f "$f" ] || continue
        cmp -s "$f" "$THEME_DIR/${f##*/}" || install -m 644 "$f" "$THEME_DIR/${f##*/}"
      done
    else
      warn "Theme fehlt in $theme_src"
    fi
  fi
  # DeviceTimeout=0: nicht auf einen Grafiktreiber warten, sofort den Bildschirmspeicher der Firmware nehmen
  # (der richtige Treiber kommt erst nach dem Initramfs, s. boot-drm)
  mkdir -p "${PCONF%/*}"
  put "$PCONF" <<EOF || true
# VoidStation: Startbild (Theme in $THEME_DIR, Einrichtung: voidstation-splash)
[Daemon]
Theme=$THEME
ShowDelay=0
DeviceTimeout=0
EOF
  if enabled; then on=1; else on=0; fi
  # Initramfs: Mit Plymouth zieht dracut das Modul "drm" mit – ohne die Zeile hier samt aller Grafiktreiber
  # und ihrer Firmware (~200 MB, passt nicht auf die EFI-Partition). Gilt auch fuer Geraete ohne
  # 10-voidstation.conf (frueher per install.sh eingerichtet).
  mkdir -p "${DOFF%/*}"
  if [ "$on" = 1 ]; then
    put "$DOFF" <<EOF || true
# VoidStation: Startbild (Plymouth) im Initramfs, aber ohne die grossen Grafiktreiber (s. voidstation-splash)
omit_drivers+=" $LATE_DRIVERS nova_core nvidia_drm nvidia_modeset nvidia_uvm "
EOF
  else
    put "$DOFF" <<'EOF' || true
# VoidStation: Startbild ist aus (sudo voidstation-splash on) – Plymouth nicht ins Initramfs
omit_dracutmodules+=" plymouth "
EOF
  fi
  set_cmdline "$on"
  sum="$(state_sum "$on")"
  need=0
  [ "$(cat "$BUILT" 2>/dev/null)" = "$sum" ] || need=1
  if [ "$CHROOT" = 1 ]; then
    [ "$need" = 1 ] && return 2
    return 0
  fi
  if [ "$need" = 1 ] && [ "$norebuild" = 1 ]; then
    return 2                                       # der Aufrufer baut neu und ruft danach "stamp"
  fi
  if [ "$need" = 1 ]; then
    rebuild || return 1
    echo "$sum" > "$BUILT" 2>/dev/null && chmod 644 "$BUILT"
    CMD_EFI=1
  fi
  if [ "$CMD_EFI" = 1 ] || [ "$CMD_GRUB" = 1 ]; then apply_boot; fi
  if [ "$on" = 1 ]; then say "Startbild: an (VoidStation-Logo beim Hochfahren)"; else say "Startbild: aus"; fi
  return 0
}

stamp() {
  if enabled; then on=1; else on=0; fi
  have_plymouth || return 0
  mkdir -p "$VSD" && state_sum "$on" > "$BUILT" && chmod 644 "$BUILT"
}

status() {
  if have_plymouth; then say "Plymouth: installiert"; else say "Plymouth: nicht installiert"; fi
  if [ -s "$THEME_DIR/$THEME.plymouth" ]; then say "Theme: $THEME_DIR"; else say "Theme: fehlt"; fi
  if [ -e "$OFF" ]; then say "Startbild: aus (sudo voidstation-splash on)"
  elif enabled; then say "Startbild: an"; else say "Startbild: nicht moeglich"; fi
  [ -f "$EFICONF" ] && say "EFISTUB-Befehlszeile: $(getval "$EFICONF" OPTIONS)"
  [ -f "$GRUBDEF" ] && say "GRUB-Befehlszeile:    $(getval "$GRUBDEF" GRUB_CMDLINE_LINUX_DEFAULT)"
  say "Laufender Start:      $(cat /proc/cmdline 2>/dev/null)"
  kv="$(newest_kernel)"
  if [ -n "$kv" ] && command -v lsinitrd >/dev/null 2>&1; then
    if lsinitrd "/boot/initramfs-$kv.img" 2>/dev/null | grep -q 'bin/plymouthd$'; then
      say "Initramfs ($kv): mit Plymouth"
    else
      say "Initramfs ($kv): ohne Plymouth"
    fi
  fi
  if enabled; then on=1; else on=0; fi
  if [ "$(cat "$BUILT" 2>/dev/null)" = "$(state_sum "$on")" ]; then say "Stand: aktuell"
  else say "Stand: Initramfs noch nicht neu gebaut (sudo voidstation-splash setup)"; fi
}

need_root() { [ "$(id -u)" = 0 ] || { echo "Bitte mit sudo starten: sudo voidstation-splash $1"; exit 1; }; }

cmd="${1:-status}"; [ $# -gt 0 ] && shift
case "$cmd" in
  setup)     need_root setup; setup "$@"; exit $? ;;
  off)       need_root off; is_live && { echo "Im Live-System nicht moeglich"; exit 1; }
             mkdir -p "$VSD" && : > "$OFF" && chmod 644 "$OFF"; setup; exit $? ;;
  on)        need_root on; is_live && { echo "Im Live-System nicht moeglich"; exit 1; }
             have_plymouth || { echo "Plymouth ist nicht installiert"; exit 1; }
             rm -f "$OFF"; setup; exit $? ;;
  stamp)     need_root stamp; stamp; exit $? ;;
  status)    status ;;
  boot-drm)  boot_drm ;;
  boot-quit) boot_quit ;;
  *) echo "Aufruf: voidstation-splash setup [--theme DIR] [--no-rebuild] | on | off | status | stamp"; exit 1 ;;
esac
exit 0
