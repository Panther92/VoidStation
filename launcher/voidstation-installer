def live_disks():
    """Platten, von denen das Live-System laeuft (werden nie angeboten). Auch ueber Ventoy/dm-Geraete."""
    out = set()
    for mp in ("/run/initramfs/live", "/run/initramfs/isoscan", "/run/initramfs/ventoy"):
        if mounted(mp):
            src = sh(["findmnt", "-no", "SOURCE", mp], check=False, quiet=True).stdout.strip()
            if src.startswith("/dev/"):
                src = os.path.realpath(src)
                for l in sh(["lsblk", "-snlpo", "NAME,TYPE", src], check=False, quiet=True).stdout.splitlines():
                    f = l.split()
                    if len(f) == 2 and f[1] == "disk":
                        out.add(f[0])
    return out


def live_disk():
    ld = sorted(live_disks())
    return ld[0] if ld else None


def cpu_name():
    try:
        for l in open("/proc/cpuinfo", encoding="utf-8"):
            if l.startswith("model name"):
                return re.sub(r"\s+", " ", l.split(":", 1)[1]).replace("(R)", "").replace("(TM)", "").replace(" CPU", "").strip()
    except OSError:
        pass
    return ""


def gpu_names():
    r = sh(["lspci", "-mm"], check=False, quiet=True) if shutil.which("lspci") else None
    names = []
    if r and r.returncode == 0:
        for l in r.stdout.splitlines():
            f = re.findall(r'"([^"]*)"', l)
            if len(f) >= 3 and ("VGA" in f[0] or "Display" in f[0] or "3D" in f[0]):
                vendor = f[1].replace(" Corporation", "").replace("Advanced Micro Devices, Inc. [AMD/ATI]", "AMD")
                model = re.sub(r"\s*\(rev [^)]*\)", "", f[2])
                names.append(f"{vendor.split()[0]} {model}"[:60])
    if not names:
        for d in Path("/sys/bus/pci/devices").glob("*"):
            try:
                if (d / "class").read_text().startswith("0x03"):
                    v = (d / "vendor").read_text().strip()
                    names.append({"0x8086": "Intel", "0x1002": "AMD", "0x10de": "NVIDIA"}.get(v, v))
            except OSError:
                pass
    return names


def firmware():
    """"uefi" oder "bios": wie das Live-System gestartet wurde (Tests: VS_INSTALLER_FW=uefi|bios)."""
    if TEST and os.environ.get("VS_INSTALLER_FW") in ("uefi", "bios"):
        return os.environ["VS_INSTALLER_FW"]
    return "uefi" if Path("/sys/firmware/efi").is_dir() else "bios"


def secure_boot():
    for f in Path("/sys/firmware/efi/efivars").glob("SecureBoot-*"):
        try:
            return f.read_bytes()[-1] == 1
        except OSError:
            pass
    return False


def net_state():
    try:
        routes = open("/proc/net/route").read().splitlines()[1:]
    except OSError:
        routes = []
    for l in routes:
        f = l.split()
        if len(f) > 2 and f[1] == "00000000":
            return "wifi" if Path(f"/sys/class/net/{f[0]}/wireless").exists() else "lan"
    return "none"


def with_mount(dev, fstype, fn, rw=False):
    """dev kurz einhaengen (standardmaessig nur lesend), fn(mountpunkt) aufrufen."""
    PROBEMNT.mkdir(parents=True, exist_ok=True)
    opts = "rw" if rw else "ro"
    if fstype == "ntfs":
        cmd = ["mount", "-t", "ntfs3", "-o", opts, dev, str(PROBEMNT)]
        if sh(cmd, check=False, quiet=True).returncode != 0:
            cmd = ["ntfs-3g", "-o", opts, dev, str(PROBEMNT)]
            if sh(cmd, check=False, quiet=True).returncode != 0:
                return None
    else:
        # nur lesen heisst auch: kein Journal/Log nachspielen (ein schlafendes Linux bliebe sonst nicht heil)
        extra = {"ext4": ",noload", "ext3": ",noload", "xfs": ",norecovery", "btrfs": ",rescue=nologreplay"}.get(fstype, "") if not rw else ""
        if sh(["mount", "-t", fstype, "-o", opts + extra, dev, str(PROBEMNT)], check=False, quiet=True).returncode != 0:
            if fstype == "btrfs" and not rw:
                extra = ",nologreplay"                 # aeltere Kernel
            elif fstype in ("vfat", "exfat") or rw:
                extra = ""
            else:
                return None
            if sh(["mount", "-t", fstype, "-o", opts + extra, dev, str(PROBEMNT)], check=False, quiet=True).returncode != 0:
                return None
    try:
        return fn(PROBEMNT)
    except OSError as e:                                   # kaputtes oder seltsames Dateisystem: nur nichts erkennen
        log("Lesen fehlgeschlagen:", dev, e)
        return None
    finally:
        sh(["umount", str(PROBEMNT)], check=False, quiet=True)


def os_release_name(root):
    for cand in (root / "etc/os-release", root / "usr/lib/os-release", root / "@/etc/os-release", root / "@rootfs/etc/os-release"):
        try:
            txt = cand.read_text(encoding="utf-8", errors="replace")
        except OSError:
            continue
        m = re.search(r'^PRETTY_NAME="?([^"\n]+)"?', txt, re.M) or re.search(r'^NAME="?([^"\n]+)"?', txt, re.M)
        if m:
            return m.group(1).strip()
    return None


def esp_loaders(root):
    """Bekannte EFI-Lader auf einer EFI-Partition (Pfade relativ zur Partition)."""
    found = []
    efi = next((d for d in root.iterdir() if d.name.lower() == "efi" and d.is_dir()), None) if root.is_dir() else None
    if not efi:
        return found
    for vendor in sorted(efi.iterdir()):
        if not vendor.is_dir():
            continue
        files = {f.name.lower(): f.name for f in vendor.iterdir() if f.is_file()}
        v = vendor.name
        for want, name in (("bootmgfw.efi", "Windows"), ("shimx64.efi", None), ("grubx64.efi", None),
                           ("loader.efi", "FreeBSD"), ("bootx64.efi", None)):
            if want in files:
                if v.lower() == "microsoft" or v.lower() == "voidstation" or v.lower() == "void_grub":
                    if want != "bootmgfw.efi":
                        continue
                label = name or ("UEFI-Standard" if v.lower() == "boot" else v.capitalize())
                found.append({"path": f"/EFI/{v}/{files[want]}", "name": label, "vendor": v.lower()})
                break
        if v.lower() == "microsoft":
            ms = vendor / "Boot"
            if ms.is_dir():
                for f in ms.iterdir():
                    if f.name.lower() == "bootmgfw.efi":
                        found.append({"path": f"/EFI/{v}/Boot/{f.name}", "name": "Windows", "vendor": "microsoft"})
    # doppelte Eintraege (z. B. Windows) zusammenfassen
    seen, uniq = set(), []
    for l in found:
        if l["path"].lower() not in seen:
            seen.add(l["path"].lower()); uniq.append(l)
    return uniq


def hibernated(root):
    """Windows schlaeft (Ruhezustand oder Schnellstart), wenn hiberfil.sys mit hibr/wake beginnt."""
    for f in root.iterdir() if root.is_dir() else []:
        if f.name.lower() == "hiberfil.sys":
            try:
                with open(f, "rb") as fh:
                    return fh.read(4).lower() in (b"hibr", b"wake")
            except OSError:
                return False
    return False


def ntfs_info(dev):
    """Mindestgroesse und Zustand einer NTFS-Partition ueber ntfsresize --info (liest nur)."""
    r = sh(["ntfsresize", "--info", "--no-progress-bar", dev], check=False, quiet=True)
    out = r.stdout + r.stderr
    info = {"hibernated": bool(re.search(r"hibernat", out, re.I)), "dirty": bool(re.search(r"inconsistent|chkdsk|scheduled for check", out, re.I))}
    m = re.search(r"You might resize at (\d+) bytes", out)
    if m:
        info["min"] = int(m.group(1))
    m = re.search(r"Space in use\s*:\s*(\d+) MB", out)
    if m:
        info["used"] = int(m.group(1)) * 1000 * 1000
    return info


def ext_info(dev):
    info = {}
    d = sh(["dumpe2fs", "-h", dev], check=False, quiet=True).stdout
    bs = int(re.search(r"Block size:\s*(\d+)", d).group(1)) if "Block size" in d else 4096
    bc = re.search(r"Block count:\s*(\d+)", d)
    fb = re.search(r"Free blocks:\s*(\d+)", d)
    if bc and fb:
        info["used"] = (int(bc.group(1)) - int(fb.group(1))) * bs
    r = sh(["resize2fs", "-P", dev], check=False, quiet=True)
    m = re.search(r"minimum size of the filesystem:\s*(\d+)", r.stdout + r.stderr)
    if m:
        info["min"] = int(m.group(1)) * bs
    elif "used" in info:
        info["min"] = int(info["used"] * 1.15)
    return info


def btrfs_devices(dev):
    m = re.search(r"Total devices\s+(\d+)", sh(["btrfs", "filesystem", "show", dev], check=False, quiet=True).stdout)
    return int(m.group(1)) if m else 1


def btrfs_info(dev):
    if btrfs_devices(dev) > 1:
        return {"multi": True}                            # ueber mehrere Geraete: wird nicht verkleinert
    def f(mnt):
        info = {}
        r = sh(["btrfs", "inspect-internal", "min-dev-size", str(mnt)], check=False, quiet=True)
        m = re.search(r"(\d+)\s+bytes", r.stdout)
        if m:
            info["min"] = int(int(m.group(1)) * 1.1)
        r = sh(["btrfs", "filesystem", "usage", "-b", str(mnt)], check=False, quiet=True)
        m = re.search(r"Used:\s+(\d+)", r.stdout)
        if m:
            info["used"] = int(m.group(1))
        info["os"] = os_release_name(mnt)
        return info
    return with_mount(dev, "btrfs", f) or {}


def disk_table(disk):
    r = sh(["sfdisk", "-J", disk], check=False, quiet=True)
    try:
        return json.loads(r.stdout)["partitiontable"]
    except (ValueError, KeyError):
        return None


def free_regions(pt, size_bytes):
    """Freie Bereiche einer GPT-Tabelle in Sektoren (ausgerichtet auf 1 MiB)."""
    ss = pt.get("sectorsize", 512)
    al = MiB // ss
    first = pt.get("firstlba", 2048)
    last = pt.get("lastlba", size_bytes // ss - 34)
    parts = sorted(pt.get("partitions", []), key=lambda p: p["start"])
    regions, cur = [], first
    for p in parts + [{"start": last + 1, "size": 0}]:
        s = align_up(cur, al)
        e = p["start"]                              # exklusiv
        if e - s >= (64 * MiB) // ss:
            n = (e - s) // al * al
            regions.append({"start": s, "sectors": n, "bytes": n * ss})
        cur = max(cur, p["start"] + p["size"])
    return regions


def probe():
    lds = live_disks()
    ld = sorted(lds)[0] if lds else None
    lsb = json.loads(sh(["lsblk", "-J", "-b", "-o", "NAME,PATH,TYPE,SIZE,MODEL,TRAN,RM,RO,FSTYPE,PARTTYPE,LABEL,UUID"],
                        quiet=True).stdout)
    uefi = firmware() == "uefi"
    res = {"uefi": uefi, "secureboot": uefi and secure_boot(), "arch": os.uname().machine,
           "ram": 0, "cpu": cpu_name(), "gpu": gpu_names(), "net": net_state(), "live_disk": ld,
           "disks": [], "windows": False, "hibernated": False, "bitlocker": False, "min_root": MIN_ROOT, "esp_size": ESP_SIZE,
           "users": sorted({l.split(":", 1)[0] for l in open("/etc/passwd", encoding="utf-8") if ":" in l})}
    try:
        res["ram"] = int(re.search(r"MemTotal:\s+(\d+)", open("/proc/meminfo").read()).group(1)) * 1024
    except (OSError, AttributeError):
        pass
    for d in lsb.get("blockdevices", []):
        if d.get("type") not in DISK_TYPES or d.get("ro") or not d.get("size") or d["path"] in lds:
            continue
        if re.match(r"/dev/(zram|ram|sr|fd)", d["path"]) or re.search(r"mmcblk\d+boot|rpmb", d["path"]):
            continue
        if d.get("tran") == "usb" or d.get("rm"):
            continue                                              # USB-Sticks/-Platten werden nicht angeboten
        mps = sh(["lsblk", "-lnpo", "MOUNTPOINTS", d["path"]], check=False, quiet=True).stdout.split()
        if any(m in ("/", "/usr", "/boot") for m in mps):
            continue                                              # Platte des gerade laufenden Systems
        disk = {"path": d["path"], "size": d["size"], "model": (d.get("model") or "").strip(), "tran": d.get("tran") or "",
                "label": None, "parts": [], "free": [], "systems": [], "esp": None, "options": {}}
        pt = disk_table(d["path"])
        if pt:
            disk["label"] = pt.get("label")
            disk["sectorsize"] = pt.get("sectorsize", 512)
        byname = {c["path"]: c for c in d.get("children", []) or []}
        for p in (pt or {}).get("partitions", []):
            c = byname.get(p["node"], {})
            ptype = (p.get("type") or "").lower()
            fs = c.get("fstype") or blkid(p["node"], "TYPE")          # lsblk kennt es nur mit laufendem udev
            part = {"path": p["node"], "num": int(re.search(r"(\d+)$", p["node"]).group(1)), "start": p["start"],
                    "sectors": p["size"], "size": p["size"] * disk.get("sectorsize", 512), "type": ptype,
                    "fstype": fs, "label": c.get("label") or blkid(p["node"], "LABEL") or p.get("name") or "",
                    "uuid": c.get("uuid") or blkid(p["node"], "UUID"),
                    "role": "data", "os": None, "shrink": False}
            if ptype == GUID["esp"] or (fs == "vfat" and ptype in ("ef", "0xef")):
                part["role"] = "esp"
                part["loaders"] = with_mount(p["node"], "vfat", esp_loaders) or []
                part["free_bytes"] = with_mount(p["node"], "vfat", lambda m: shutil.disk_usage(m).free) or 0
                if disk["esp"] is None:
                    disk["esp"] = p["node"]
                for l in part["loaders"]:
                    if l["vendor"] == "microsoft":
                        res["windows"] = True
            elif ptype in (GUID["msres"], GUID["bios_boot"]):
                part["role"] = "reserved"
            elif ptype == GUID["winre"]:
                part["role"] = "recovery"; part["os"] = "Windows"
            elif fs == "BitLocker":
                part["role"] = "os"; part["os"] = "Windows (BitLocker)"; part["locked"] = True; res["windows"] = True
                res["bitlocker"] = True
            elif fs == "ntfs":
                ni = ntfs_info(p["node"])
                part.update({k: v for k, v in ni.items() if k in ("min", "used", "hibernated", "dirty")})
                look = with_mount(p["node"], "ntfs", lambda m: ((m / "Windows" / "System32").is_dir(), hibernated(m))) or (False, False)
                win = look[0]
                part["hibernated"] = part.get("hibernated") or look[1]
                part["role"] = "os" if win else "data"
                part["os"] = "Windows" if win else None
                if win:
                    res["windows"] = True
                if part["hibernated"]:
                    res["hibernated"] = True
                part["shrink"] = "min" in ni
            elif fs in ("ext4", "ext3", "ext2"):
                part.update(ext_info(p["node"]))
                name = with_mount(p["node"], fs, os_release_name)
                part["role"], part["os"] = ("os", name) if name else ("data", None)
                part["shrink"] = "min" in part
            elif fs == "btrfs":
                bi = btrfs_info(p["node"])
                part.update({k: v for k, v in bi.items() if k in ("min", "used")})
                if bi.get("multi"):
                    part["locked"] = True
                part["role"], part["os"] = ("os", bi["os"]) if bi.get("os") else ("data", None)
                part["shrink"] = "min" in part
            elif fs == "xfs":
                name = with_mount(p["node"], "xfs", os_release_name)
                part["role"], part["os"] = ("os", name) if name else ("data", None)
            elif fs == "swap" or ptype == GUID["swap"]:
                part["role"] = "swap"
            elif fs == "crypto_LUKS":
                part["role"] = "os"; part["os"] = "LUKS"; part["locked"] = True
            elif fs == "LVM2_member":
                part["role"] = "os"; part["os"] = "LVM"; part["locked"] = True
            elif ptype in (GUID["fbsd_ufs"], GUID["fbsd_zfs"], GUID["fbsd_boot"], GUID["fbsd_swap"]) or fs in ("ufs", "zfs_member"):
                part["role"] = "os" if ptype != GUID["fbsd_swap"] else "swap"; part["os"] = "FreeBSD"
            elif ptype == GUID["openbsd"]:
                part["role"] = "os"; part["os"] = "OpenBSD"
            elif ptype == GUID["netbsd"]:
                part["role"] = "os"; part["os"] = "NetBSD"
            disk["parts"].append(part)
        if pt and pt.get("label") == "gpt":
            disk["free"] = free_regions(pt, d["size"])
        # erkannte Systeme (Namen fuer die Oberflaeche)
        names = []
        for p in disk["parts"]:
            if p["os"] and p["os"] not in names and p["role"] == "os":
                names.append(p["os"])
        for p in disk["parts"]:
            for l in p.get("loaders", []):
                if l["name"] not in names and l["name"] not in ("UEFI-Standard",) and l["vendor"] not in ("voidstation",):
                    if not any(l["name"].lower() in n.lower() or n.lower().startswith(l["name"].lower()) for n in names):
                        names.append(l["name"])
        disk["systems"] = names
        esp_need = 0 if disk["esp"] else ESP_SIZE
        # --- Wege: ganze SSD, neben einem System (verkleinern), freier Platz
        if disk["size"] >= MIN_ROOT + ESP_SIZE + GiB:
            disk["options"]["whole"] = True
        beside = []
        if disk["label"] == "gpt" and uefi:                # BIOS-Modus: nur ganze SSD
            for p in disk["parts"]:
                if p["fstype"] == "ntfs" and p["role"] == "os" and (p.get("hibernated") or p.get("dirty")):
                    # Windows im Ruhezustand/Schnellstart oder mit Dateisystemfehlern: erst in Windows beheben
                    beside.append({"part": p["path"], "os": p["os"], "fstype": "ntfs", "size": p["size"],
                                   "blocked": "hibernated" if p.get("hibernated") else "dirty"})
                    continue
                if not p["shrink"] or p.get("locked") or p["fstype"] not in SHRINKABLE:
                    continue
                keep_min = p["min"] + HEADROOM
                max_new = (p["size"] - keep_min) // MiB * MiB - esp_need
                if max_new >= MIN_ROOT:
                    default = max(MIN_ROOT, min(max_new, (p["size"] - p["min"]) // 2 // GiB * GiB))
                    beside.append({"part": p["path"], "os": p["os"] or p["label"] or p["fstype"].upper(), "fstype": p["fstype"],
                                   "size": p["size"], "used": p.get("used"), "min": p["min"], "max_new": max_new,
                                   "default": default, "hibernated": p.get("hibernated", False), "dirty": p.get("dirty", False)})
            free = [r for r in disk["free"] if r["bytes"] - esp_need >= MIN_ROOT]
            if free:
                disk["options"]["free"] = sorted(free, key=lambda r: -r["bytes"])
        if beside:
            disk["options"]["beside"] = beside
        res["disks"].append(disk)
    res["disks"].sort(key=lambda x: (x["tran"] == "usb", x["path"]))
    if res["hibernated"]:
        # Schnellstart/Ruhezustand haelt ALLE NTFS-Laufwerke von Windows fest: keines davon verkleinern
        for d in res["disks"]:
            for o in d["options"].get("beside", []):
                if o["fstype"] == "ntfs" and not o.get("blocked"):
                    o["blocked"] = "hibernated"
    res["wifi_saved"] = saved_wifi()
    return res


def saved_wifi():
    """WLAN-Netze, die im Live-System gespeichert sind (werden auf Wunsch uebernommen)."""
    out = []
    d = Path("/etc/NetworkManager/system-connections")
    for f in sorted(d.glob("*")) if d.is_dir() else []:
        try:
            txt = f.read_text(encoding="utf-8", errors="replace")
        except OSError:
            continue
        m = re.search(r"^\[wifi\][^\[]*?^ssid=(.+)$", txt, re.M | re.S)
        if m and m.group(1).strip() not in out:
            out.append(m.group(1).strip())
    return out


# ---------------------------------------------------------------------------
#  Installation
# ---------------------------------------------------------------------------
class Run:
    def __init__(self, st):
        self.st = st
        self.cfg = st["config"]
        pw = self.cfg.get("user", {}).get("password")
        if pw and pw not in SECRETS:
            SECRETS.append(pw)
        self.pct_done = 0.0
        self.bios = firmware() == "bios"
        self.alt = False

    # --- Fortschritt
    def weights(self):
        return {p: (0 if (p == "shrink" and self.cfg["mode"] != "beside") else WEIGHT[p]) for p in PHASES}

    def progress(self, phase, frac, **detail):
        w = self.weights()
        total = sum(w.values())
        before = sum(w[p] for p in PHASES[:PHASES.index(phase)])
        emit(ev="progress", phase=phase, phase_pct=round(frac * 100, 1),
             pct=round((before + w[phase] * frac) / total * 100, 1), **detail)

    def mark_done(self, phase):
        self.st.setdefault("done", [])
        if phase not in self.st["done"]:
            self.st["done"].append(phase)
        if phase == "configure":
            self.cfg["user"]["password"] = ""              # danach nicht mehr noetig
        save_state(self.st)

    # --- Einhaengen
    def dev(self, which):
        """root_dev/esp_dev pruefen: stimmt die GPT-Kennung noch? (Nummern koennen sich zwischen Versuchen aendern)"""
        d, pu = self.st.get(which + "_dev"), self.st.get(which + "_pu")
        if pu and (not d or partuuid(d).lower() != pu.lower()):
            d = dev_by_partuuid(pu)
            if not d:
                raise Fail("partition", f"{which}: Partition {pu} nicht mehr gefunden")
            self.st[which + "_dev"] = d; save_state(self.st)
        if not d or not Path(d).exists():
            raise Fail("partition", f"{which}: {d} fehlt")
        return d

    def mount_target(self):
        TARGET.mkdir(parents=True, exist_ok=True)
        if not mounted(TARGET):
            sh(["mount", "-t", "ext4", self.dev("root"), str(TARGET)])
        esp = TARGET / "boot/efi"
        esp.mkdir(parents=True, exist_ok=True)
        if not mounted(esp):
            sh(["mount", "-t", "vfat", self.dev("esp"), str(esp)])

    def mount_pseudo(self):
        for d in ("proc", "sys", "dev", "run", "tmp"):
            (TARGET / d).mkdir(exist_ok=True)
        if not mounted(TARGET / "proc"):
            sh(["mount", "-t", "proc", "proc", str(TARGET / "proc")])
        for d in ("sys", "dev", "run"):
            if not mounted(TARGET / d):
                sh(["mount", "--rbind", f"/{d}", str(TARGET / d)])
                sh(["mount", "--make-rslave", str(TARGET / d)], check=False)

    def umount_all(self):
        sh(["sync"], check=False)
        if mounted(TARGET):
            if sh(["umount", "-R", str(TARGET)], check=False).returncode != 0:
                sh(["umount", "-Rl", str(TARGET)], check=False)

    # --- Ablauf
    def run(self, alt=False):
        self.alt = alt and not self.bios                  # Ausweichweg gibt es nur fuer UEFI
        done = set(self.st.get("done", []))
        for ph in PHASES:
            if ph in done:
                continue
            if ph == "shrink" and self.cfg["mode"] != "beside":
                self.mark_done(ph)
                continue
            self.st["current"] = ph
            save_state(self.st)
            emit(ev="phase", phase=ph, state="running")
            self.progress(ph, 0)
            try:
                getattr(self, "ph_" + ph)()
            except Fail as e:
                self.fail(ph, e.code, e.msg)
                return 1
            except Exception as e:  # noqa: BLE001
                self.fail(ph, "internal", repr(e))
                return 1
            self.progress(ph, 1)
            emit(ev="phase", phase=ph, state="done")
            self.mark_done(ph)
        self.st["finished"] = time.time()
        self.cfg["user"]["password"] = ""                  # nicht laenger als noetig aufheben
        save_state(self.st)
        emit(ev="done", pct=100, seconds=int(time.time() - self.st["started"]), user=self.cfg["user"]["name"],
             login=self.cfg["user"]["login"], hostname=self.cfg["hostname"])
        return 0

    def fail(self, phase, code, msg):
        log("FEHLER", phase, code, msg)
        tail = []
        try:
            tail = [l for l in LOG.read_text(encoding="utf-8").splitlines() if not l[9:].startswith("EVENT")][-6:]
        except OSError:
            pass
        self.st["error"] = {"phase": phase, "code": code, "msg": msg}
        save_state(self.st)
        emit(ev="error", phase=phase, code=code, msg=msg[-600:], done=self.st.get("done", []),
             foreign_untouched=self.st.get("foreign_untouched", True), log=tail,
             alt=(phase == "boot" and not self.bios))
        # Einhaengungen fuer einen neuen Versuch loesen
        self.umount_all()

    # --- 1. Pruefen (vor jeder Aenderung; bei neuen Versuchen erneut)
    def free_disk(self, disk):
        """Alles auf dieser Platte aushaengen; bleibt etwas belegt, wird abgebrochen."""
        for _ in range(2):
            for l in sh(["lsblk", "-lnpo", "NAME", disk], quiet=True).stdout.split():
                for mp in sh(["findmnt", "-rno", "TARGET", "-S", l], check=False, quiet=True).stdout.split():
                    sh(["umount", mp.encode().decode("unicode_escape")], check=False)
                sh(["swapoff", l], check=False, quiet=True)
        busy = []
        swaps = {x.split()[0] for x in open("/proc/swaps").read().splitlines()[1:] if x.strip()}
        for l in sh(["lsblk", "-lnpo", "NAME", disk], quiet=True).stdout.split():
            if sh(["findmnt", "-rno", "TARGET", "-S", l], check=False, quiet=True).stdout.strip():
                busy.append(l + " eingehaengt")
            if l in swaps:
                busy.append(l + " Swap")
            holders = Path(f"/sys/class/block/{Path(l).name}/holders")
            if holders.is_dir() and any(holders.iterdir()):
                busy.append(l + " belegt (" + ", ".join(h.name for h in holders.iterdir()) + ")")
        if busy:
            raise Fail("busy", "; ".join(busy))

    def ph_check(self):
        c = self.cfg
        if not LIVE_MARK.exists() and not TEST:
            raise Fail("not_live", "Der Installer laeuft nur im Live-System.")
        if self.bios and c["mode"] != "whole":
            raise Fail("bios_whole_only")               # Dual-Boot/eigene Partitionen nur im UEFI-Modus
        disk = c["disk"]
        if not Path(disk).exists():
            raise Fail("no_disk", disk)
        if disk in live_disks():
            raise Fail("live_disk")
        size = int(sh(["blockdev", "--getsize64", disk]).stdout)
        if c["mode"] == "whole" and size < MIN_ROOT + ESP_SIZE:
            raise Fail("too_small")
        self.umount_all()
        self.free_disk(disk)
        if c["mode"] == "manual":
            for d in {disk_of(c["manual"]["root"]), disk_of(c["manual"]["esp"])} - {disk}:
                self.free_disk(d)
            if c["manual"].get("format_esp"):
                own = with_mount(c["manual"]["esp"], "vfat", esp_loaders) or []
                if any(l["vendor"] not in ("voidstation", "boot") for l in own):
                    raise Fail("esp_foreign", ", ".join(l["name"] for l in own))
        self.st.setdefault("foreign_untouched", True)
        pt = disk_table(disk)
        if c["mode"] in ("beside", "free"):
            if not pt or pt.get("label") != "gpt":
                raise Fail("not_gpt")
            ss = int(sh(["blockdev", "--getss", disk]).stdout)
            if ss != pt.get("sectorsize", 512):
                raise Fail("partition", f"Sektorgroesse {ss} passt nicht zur Tabelle")
        if c["mode"] == "free" and not self.st.get("appended"):
            r = c["region"]
            if not any(f["start"] <= r["start"] and r["start"] + r["sectors"] <= f["start"] + f["sectors"]
                       for f in free_regions(pt, size)):
                raise Fail("bad_size", "freier Bereich passt nicht mehr")
        if c["mode"] == "beside" and not self.st.get("shrink_plan"):
            p = c["part"]
            fs = blkid(p, "TYPE")
            if fs not in SHRINKABLE:
                raise Fail("not_shrinkable", fs)
            me = next((x for x in pt["partitions"] if x["node"] == p), None)
            if not me:
                raise Fail("no_disk", p)
            if fs == "ntfs":
                info = ntfs_info(p)
                if info.get("hibernated") or with_mount(p, "ntfs", hibernated):
                    raise Fail("ntfs_hibernated")
                # Schnellstart betrifft alle Windows-Laufwerke: das Systemlaufwerk mitpruefen
                for x in pt["partitions"]:
                    if x["node"] != p and blkid(x["node"], "TYPE") == "ntfs" and with_mount(x["node"], "ntfs", hibernated):
                        raise Fail("ntfs_hibernated")
            elif fs == "btrfs":
                if btrfs_devices(p) > 1:
                    raise Fail("not_shrinkable", "btrfs ueber mehrere Geraete")
                info = btrfs_info(p)
            else:
                info = ext_info(p)
            if "min" not in info:
                raise Fail("ntfs_check" if fs == "ntfs" else "shrink_dryrun", "Mindestgroesse unbekannt")
            esp_need = 0 if self.find_esp(pt) else ESP_SIZE
            max_new = (me["size"] * pt.get("sectorsize", 512) - info["min"] - HEADROOM) // MiB * MiB - esp_need
            if int(c["new_size"]) > max_new:
                raise Fail("bad_size", f"hoechstens {max_new // GiB} GiB moeglich")
        self.progress("check", 1)

    # --- 2. Platz schaffen (nur "neben einem System")
    # Der Plan wird einmal festgelegt und gespeichert; ein neuer Versuch setzt genau dort fort,
    # wo der letzte aufgehoert hat (Dateisystem schon kleiner? Tabelle schon geaendert?).
    def ph_shrink(self):
        c = self.cfg
        if c["mode"] != "beside":
            return
        disk, p = c["disk"], c["part"]
        plan = self.st.get("shrink_plan")
        if not plan:
            pt = disk_table(disk)
            ss = pt.get("sectorsize", 512)
            me = next((x for x in pt["partitions"] if x["node"] == p), None)
            if not me:
                raise Fail("no_disk", p)
            old_bytes = me["size"] * ss
            esp_need = 0 if self.find_esp(pt) else ESP_SIZE
            new_part_bytes = (old_bytes - int(c["new_size"]) - esp_need) // MiB * MiB
            if new_part_bytes <= 0:
                raise Fail("bad_size")
            plan = {"num": int(re.search(r"(\d+)$", p).group(1)), "pu": partuuid(p), "start": me["start"], "ss": ss,
                    "old_sectors": me["size"], "new_sectors": new_part_bytes // ss, "fs": blkid(p, "TYPE"),
                    "fs_bytes": new_part_bytes - MiB}           # Dateisystem etwas kleiner als die Partition
            self.st["shrink_plan"] = plan; save_state(self.st)
        p = dev_by_partuuid(plan["pu"]) or p
        fs, fs_bytes, ss = plan["fs"], plan["fs_bytes"], plan["ss"]
        log(f"Verkleinere {p} ({fs}): {plan['old_sectors']} -> {plan['new_sectors']} Sektoren")
        if not self.st.get("fs_resized"):
            if fs == "ntfs":
                self.progress("shrink", 0.05, detail="check")
                r = sh(["ntfsresize", "--no-action", "--no-progress-bar", "--size", str(fs_bytes), p], check=False)
                if r.returncode != 0:
                    raise Fail("shrink_dryrun", (r.stdout + r.stderr)[-400:])
                self.st["foreign_untouched"] = False; save_state(self.st)
                self.progress("shrink", 0.2, detail="resize")
                r = sh(["ntfsresize", "--no-progress-bar", "--size", str(fs_bytes), p], input="y\n", check=False)
                if r.returncode != 0:
                    raise Fail("shrink_fs", (r.stdout + r.stderr)[-400:])
            elif fs in ("ext4", "ext3", "ext2"):
                self.progress("shrink", 0.05, detail="check")
                r = sh(["e2fsck", "-f", "-p", p], check=False)
                if r.returncode >= 4:
                    raise Fail("shrink_dryrun", (r.stdout + r.stderr)[-400:])
                self.st["foreign_untouched"] = False; save_state(self.st)
                self.progress("shrink", 0.3, detail="resize")
                sh(["resize2fs", p, f"{fs_bytes // 1024}K"])
            elif fs == "btrfs":
                mnt = RUNDIR / "btrfs"
                mnt.mkdir(parents=True, exist_ok=True)
                sh(["mount", "-t", "btrfs", p, str(mnt)])
                try:
                    self.st["foreign_untouched"] = False; save_state(self.st)
                    self.progress("shrink", 0.3, detail="resize")
                    sh(["btrfs", "filesystem", "resize", f"1:{fs_bytes}", str(mnt)])
                finally:
                    sh(["umount", str(mnt)], check=False)
            else:
                raise Fail("not_shrinkable", fs)
            self.st["fs_resized"] = True; save_state(self.st)
        # Partitionstabelle: nur aendern, wenn sie noch die alte Groesse hat
        self.progress("shrink", 0.8, detail="table")
        cur = next((x for x in disk_table(disk)["partitions"] if x["start"] == plan["start"]), None)
        if not cur:
            raise Fail("partition", "Partition nach dem Verkleinern nicht gefunden")
        if cur["size"] == plan["old_sectors"]:
            sh(["sfdisk", "--no-reread", "--no-tell-kernel", "-N", str(plan["num"]), disk], input=f"size={plan['new_sectors']}\n")
            sh(["partx", "-u", disk], check=False)
            settle()
        elif cur["size"] != plan["new_sectors"]:
            raise Fail("partition", f"unerwartete Groesse {cur['size']} (erwartet {plan['new_sectors']})")
        self.st["shrunk_to"] = plan["new_sectors"] * ss
        self.st["new_region"] = {"start": plan["start"] + plan["new_sectors"], "sectors": plan["old_sectors"] - plan["new_sectors"]}
        save_state(self.st)
        # Pruefen: Dateisystem lesbar und in sich stimmig?
        if blkid(p, "TYPE") != fs:
            raise Fail("shrink_verify", f"{p}: Dateisystem nach dem Verkleinern nicht lesbar")
        if fs in ("ext4", "ext3", "ext2") and sh(["e2fsck", "-fn", p], check=False).returncode >= 4:
            raise Fail("shrink_verify", f"{p}: e2fsck meldet Fehler")
        if fs == "btrfs" and sh(["btrfs", "check", "--readonly", p], check=False).returncode != 0:
            raise Fail("shrink_verify", f"{p}: btrfs check meldet Fehler")

    def find_esp(self, pt):
        for x in pt.get("partitions", []):
            if (x.get("type") or "").lower() == GUID["esp"]:
                return x["node"]
        return None

    # --- 3. Partitionieren
    def ph_partition(self):
        c = self.cfg
        disk = c["disk"]
        mode = c["mode"]
        if mode == "manual":
            self.st["root_dev"] = c["manual"]["root"]
            self.st["esp_dev"] = c["manual"]["esp"]
            self.st["esp_new"] = bool(c["manual"].get("format_esp"))
        elif mode == "whole":
            sh(["swapoff", "-a"], check=False)
            self.free_disk(disk)
            sh(["wipefs", "-af", disk])
            self.st["foreign_untouched"] = False; save_state(self.st)
            if self.bios:
                # BIOS: GRUB braucht auf GPT eine kleine BIOS-Boot-Partition (ohne Dateisystem).
                # Die EFI-Partition kommt trotzdem dazu – dann startet die SSD auch im UEFI-Modus.
                table = (f"label: gpt\nsize=1MiB, type={GUID['bios_boot']}, name=BIOS\n"
                         "size=512MiB, type=uefi, name=EFI\ntype=linux, name=VoidStation\n")
                esp_n, root_n = 2, 3
            else:
                table = "label: gpt\nsize=512MiB, type=uefi, name=EFI\ntype=linux, name=VoidStation\n"
                esp_n, root_n = 1, 2
            sh(["sfdisk", "-q", "--wipe", "always", "--wipe-partitions", "always", disk], input=table)
            sh(["partx", "-u", disk], check=False)
            settle()
            self.st["esp_dev"], self.st["root_dev"], self.st["esp_new"] = part_path(disk, esp_n), part_path(disk, root_n), True
        elif self.st.get("appended") and self.st.get("root_pu"):
            self.dev("root"); self.dev("esp")               # neuer Versuch: Partitionen gibt es schon (Namen neu aufloesen)
        else:
            pt = disk_table(disk)
            if not pt or pt.get("label") != "gpt":
                raise Fail("not_gpt")
            ss = pt.get("sectorsize", 512)
            region = self.st.get("new_region") if mode == "beside" else c["region"]
            al = MiB // ss
            start = align_up(int(region["start"]), al)
            end = int(region["start"]) + int(region["sectors"])
            esp = self.find_esp(pt)
            lines = []
            if not esp:
                lines.append(f"start={start}, size={ESP_SIZE // ss}, type=uefi, name=EFI")
                start += ESP_SIZE // ss
            size = (end - start) // al * al
            if size * ss < MIN_ROOT - 256 * MiB:
                raise Fail("too_small")
            lines.append(f"start={start}, size={size}, type=linux, name=VoidStation")
            before = {x["node"] for x in pt.get("partitions", [])}
            sh(["sfdisk", "--no-reread", "--no-tell-kernel", "--append", disk], input="\n".join(lines) + "\n")
            sh(["partx", "-u", disk], check=False)
            sh(["partx", "-a", disk], check=False)
            settle()
            pt2 = disk_table(disk)
            new = [x for x in pt2.get("partitions", []) if x["node"] not in before]
            root = next((x["node"] for x in new if (x.get("type") or "").lower() == GUID["linux"] and x["start"] == start), None)
            espn = next((x["node"] for x in new if (x.get("type") or "").lower() == GUID["esp"]), None)
            if not root:
                raise Fail("partition", "neue Partition nicht gefunden")
            self.st["root_dev"] = root
            self.st["esp_dev"] = espn or esp
            self.st["esp_new"] = bool(espn)
            self.st["appended"] = True
        for _ in range(20):
            if Path(self.st["root_dev"]).exists() and Path(self.st["esp_dev"]).exists():
                break
            time.sleep(0.5)
        else:
            raise Fail("partition", "Partitionen erscheinen nicht")
        # Kernel und Tabelle muessen dieselbe Groesse sehen, sonst wuerde mkfs ins Leere schreiben
        for which in ("root", "esp"):
            d = self.st[which + "_dev"]
            if disk_of(d) == disk and mode != "manual":
                sysd = Path(f"/sys/class/block/{Path(d).name}")
                tab = next((x for x in disk_table(disk)["partitions"] if x["node"] == d), None)
                if tab and (sysd / "size").exists() and int((sysd / "size").read_text()) * 512 != tab["size"] * disk_table(disk).get("sectorsize", 512):
                    raise Fail("partition", f"{d}: Kernel kennt die neue Groesse noch nicht")
            self.st[which + "_pu"] = partuuid(d)
            if not self.st[which + "_pu"]:
                raise Fail("partition", f"{d}: keine GPT-Kennung")
        save_state(self.st)

    # --- 4. Formatieren
    def ph_format(self):
        self.umount_all()
        root, esp = self.dev("root"), self.dev("esp")
        if self.cfg["mode"] == "manual":
            self.st["foreign_untouched"] = False; save_state(self.st)   # selbst gewaehlte Partitionen
            self.free_disk(disk_of(root))
        if self.st.get("esp_new"):
            sh(["mkfs.vfat", "-F32", "-n", "EFI", esp])
        elif blkid(esp, "TYPE") != "vfat":
            raise Fail("esp_bad", esp)
        self.progress("format", 0.3)
        sh(["mkfs.ext4", "-qF", "-L", "VoidStation", root])

    # --- 5. Kopieren
    def base_source(self):
        """Unveraendertes Live-Abbild (ohne Live-Benutzer und Aenderungen seit dem Start) einhaengen."""
        if TEST and os.environ.get("VS_INSTALLER_SRC"):
            return Path(os.environ["VS_INSTALLER_SRC"])
        if mounted(BASEMNT):
            return BASEMNT
        BASEMNT.mkdir(parents=True, exist_ok=True)
        for cand in ("/run/rootfsbase", "/run/initramfs/squashfs"):
            if Path(cand, "usr/bin").is_dir():
                return Path(cand)
        for dev in ("/dev/mapper/live-base", "/run/initramfs/squashfs/LiveOS/rootfs.img",
                    "/run/initramfs/squashfs/LiveOS/ext3fs.img"):
            if Path(dev).exists():
                opts = "ro,loop" if dev.endswith(".img") else "ro"
                if sh(["mount", "-o", opts + ",noload", dev, str(BASEMNT)], check=False).returncode == 0 or \
                   sh(["mount", "-o", opts, dev, str(BASEMNT)], check=False).returncode == 0:
                    if (BASEMNT / "usr/bin").is_dir():
                        return BASEMNT
                    sh(["umount", str(BASEMNT)], check=False)
        raise Fail("copy", "Live-Abbild nicht gefunden (/run/rootfsbase, live-base, rootfs.img)")

    def ph_copy(self):
        self.mount_target()
        src = self.base_source()
        self.progress("copy", 0.01, detail="count")
        total = int(sh(["du", "-sxb", str(src)], quiet=True).stdout.split()[0])
        tar_c = ["tar", "-C", str(src), "--one-file-system", "--xattrs", "--xattrs-include=*", "--acls",
                 "--numeric-owner", "-cpf", "-", "."]
        tar_x = ["tar", "-C", str(TARGET), "--xattrs", "--xattrs-include=*", "--acls", "--numeric-owner", "-xpf", "-"]
        log("$", " ".join(tar_c), "|", " ".join(tar_x))
        errs = [open(RUNDIR / f"tar-{n}.err", "w+b") for n in ("c", "x")]   # Meldungen in Dateien: Pipe laeuft nie voll
        pc = subprocess.Popen(tar_c, stdout=subprocess.PIPE, stderr=errs[0])
        px = subprocess.Popen(tar_x, stdin=subprocess.PIPE, stderr=errs[1])
        done, last, t0 = 0, 0.0, time.time()
        try:
            while True:
                chunk = pc.stdout.read(4 * MiB)
                if not chunk:
                    break
                px.stdin.write(chunk)
                done += len(chunk)
                if time.time() - last > 0.5:
                    last = time.time()
                    frac = min(0.99, done / max(total, 1))
                    rate = done / max(0.1, time.time() - t0)
                    self.progress("copy", frac, done=done, total=total, eta=int((total - done) / rate) if rate > 0 else None)
            px.stdin.close()
        except (BrokenPipeError, OSError):
            pc.kill()
        rc_c, rc_x = pc.wait(), px.wait()
        err = b""
        for e in errs:
            e.seek(0); err += e.read()[-4000:]; e.close()
        err = err.decode("utf-8", "replace")
        if err.strip():
            log(err[-3000:])
        if rc_c not in (0, 1) or rc_x != 0:                 # tar-Rueckgabe 1 = Dateien waehrend des Lesens geaendert
            raise Fail("copy", err[-400:] or f"tar {rc_c}/{rc_x}")
        for d in ("dev", "proc", "sys", "run", "tmp", "mnt", "home", "boot/efi"):
            (TARGET / d).mkdir(parents=True, exist_ok=True)
        os.chmod(TARGET / "tmp", 0o1777)
        if src == BASEMNT:
            sh(["umount", str(BASEMNT)], check=False)

    # --- 6. Einrichten
    def ph_configure(self):
        """Grundeinstellungen, dann das normale install.sh im neuen System (offline, fuer den neuen Benutzer)."""
        c = self.cfg
        u = c["user"]
        login = u["login"]
        self.mount_target()
        self.mount_pseudo()
        T = TARGET
        # Live-Reste und Live-Benutzer entfernen
        for f in ("etc/voidstation-live", "etc/runit/core-services/99-voidstation-live.sh", "etc/profile.d/zz-voidstation-live.sh",
                  "etc/sudoers.d/zz-voidstation-installer", "etc/sudoers.d/99-void-live", "usr/local/sbin/voidstation-installer",
                  "etc/default/live.conf", "etc/polkit-1/rules.d/void-live.rules", "etc/xdg/autostart/voidstation-live.desktop"):
            p = T / f
            if p.exists() or p.is_symlink():
                p.unlink()
        issue = T / "etc/issue"                            # Begruessung des Live-Sticks ("root:voidlinux …")
        try:
            if "Live" in issue.read_text(errors="replace"):
                issue.write_text("VoidStation – Void Linux \\r (\\l)\n\n")
        except OSError:
            pass
        if chroot(["id", "tv"], check=False).returncode == 0 and login != "tv":
            chroot(["userdel", "-r", "tv"], check=False)
        # Nur fuer den Stick: GParted, Startbild (Plymouth) – und der NVIDIA-Treiber, wenn der Stick nicht
        # ueber "NVIDIA only" laeuft (mit ihm gehen dkms, gcc und die Kernel-Header, sonst je Kernel-Update ein Modulbau)
        nv = nvidia_active()
        drop = [p for p in ("gparted", "plymouth") + (() if nv else ("nvidia",))
                if chroot(["xbps-query", p], check=False).returncode == 0]
        if drop:
            chroot(["xbps-remove", "-Ry"] + drop, check=False)
        shutil.rmtree(T / "usr/share/plymouth/themes/voidstation", ignore_errors=True)
        # Treiberwahl des Sticks aufloesen: mit NVIDIA gilt wieder die Sperre fuer nouveau aus dem Paket
        # (/usr/lib/modprobe.d/nvidia.conf), nvidia_drm laedt beim Start mit Kernel-Modesetting
        (T / "etc/modprobe.d/nvidia.conf").unlink(missing_ok=True)
        if nv:
            ml = T / "etc/modules-load.d"
            ml.mkdir(parents=True, exist_ok=True)
            (ml / "voidstation-nvidia.conf").write_text(
                "# VoidStation: NVIDIA-Treiber mit Kernel-Modesetting (Optionen: /etc/modprobe.d/voidstation-nvidia.conf)\n"
                "nvidia_drm\n")
            log("NVIDIA-Treiber wird uebernommen")
        else:
            (T / "etc/modprobe.d/voidstation-nvidia.conf").unlink(missing_ok=True)
        # Grundeinstellungen
        (T / "etc/hostname").write_text(c["hostname"] + "\n")
        mid = uuid.uuid4().hex + "\n"                     # eigene Kennung je Installation (nicht die vom Stick)
        (T / "etc/machine-id").write_text(mid)
        if (T / "var/lib/dbus").is_dir():
            (T / "var/lib/dbus/machine-id").write_text(mid)
        lang = c.get("lang", "de")
        (T / "etc/locale.conf").write_text("LANG=" + {"de": "de_DE.UTF-8", "en": "en_US.UTF-8"}.get(lang, "de_DE.UTF-8") + "\n")
        keymap = c.get("keymap", "de")
        rc = T / "etc/rc.conf"
        txt = rc.read_text() if rc.exists() else ""
        txt = re.sub(r"^\s*(KEYMAP|HARDWARECLOCK)=.*\n?", "", txt, flags=re.M).rstrip("\n")
        txt = re.sub(r"\n# VoidStation$", "", txt)
        txt += f'\n\n# VoidStation\nKEYMAP="{ {"de": "de", "us": "us", "gb": "uk"}.get(keymap, "de") }"\n' \
               f'HARDWARECLOCK="{"localtime" if c.get("rtc_local") else "UTC"}"\n'
        rc.write_text(txt.lstrip("\n"))
        xk = T / "etc/X11/xorg.conf.d"
        xk.mkdir(parents=True, exist_ok=True)
        (xk / "00-keyboard.conf").write_text(
            'Section "InputClass"\n  Identifier "system-keyboard"\n  MatchIsKeyboard "on"\n'
            f'  Option "XkbLayout" "{ {"de": "de", "us": "us", "gb": "gb"}.get(keymap, "de") }"\nEndSection\n')
        tz = c.get("timezone") or "Europe/Berlin"
        if not re.fullmatch(r"[A-Za-z_]+(/[A-Za-z0-9_+-]+)*", tz) or not (T / "usr/share/zoneinfo" / tz).is_file():
            tz = "Europe/Berlin"
        lt = T / "etc/localtime"
        if lt.exists() or lt.is_symlink():
            lt.unlink()
        lt.symlink_to(f"/usr/share/zoneinfo/{tz}")
        cc = T / "etc/chrony.conf"
        if c.get("rtc_local") and cc.exists():
            cc.write_text(re.sub(r"^rtcsync", "#rtcsync  # VoidStation: Hardware-Uhr in Ortszeit (Windows)", cc.read_text(), flags=re.M))
        self.progress("configure", 0.1)
        # fstab (+ Auslagerungsdatei bei wenig RAM)
        ru, eu = blkid(self.dev("root"), "UUID"), blkid(self.dev("esp"), "UUID")
        if not ru or not eu:
            raise Fail("partition", "UUID von Root- oder EFI-Partition fehlt")
        fstab = ["# <file system>  <dir>  <type>  <options>  <dump>  <pass>",
                 f"UUID={ru}  /          ext4   defaults,noatime  0 1",
                 f"UUID={eu}  /boot/efi  vfat   defaults,umask=0077  0 2",
                 "tmpfs  /tmp  tmpfs  defaults,nosuid,nodev  0 0"]
        ram_mb = int(re.search(r"MemTotal:\s+(\d+)", open("/proc/meminfo").read()).group(1)) // 1024
        if ram_mb < 7800 and not (T / "swapfile").exists() and shutil.disk_usage(T).free > 6 * GiB:
            sh(["fallocate", "-l", "2G", str(T / "swapfile")])
            os.chmod(T / "swapfile", 0o600)
            sh(["mkswap", "-q", str(T / "swapfile")])
        if (T / "swapfile").exists():
            fstab.append("/swapfile  none  swap  defaults  0 0")
        (T / "etc/fstab").write_text("\n".join(fstab) + "\n")
        self.progress("configure", 0.2)
        # Benutzer
        if chroot(["id", login], check=False).returncode != 0:
            groups = [g for g in ("wheel", "audio", "video", "input", "render", "network", "plugdev")
                      if chroot(["getent", "group", g], check=False).returncode == 0]
            chroot(["useradd", "-m", "-U", "-s", "/bin/bash", "-G", ",".join(groups), "-c", u["name"], login])
        # -c SHA512: ohne Verfahren nimmt chpasswd den PAM-Weg, und Voids pam.d/chpasswd hat dort nur
        # pam_permit – meldet Erfolg, schreibt aber nichts (Konten blieben gesperrt)
        chroot(["chpasswd", "-c", "SHA512"], input=f"{login}:{u['password']}\nroot:{u['password']}\n")
        for acct in (login, "root"):
            if not shadow_hash(T, acct).startswith("$"):
                raise Fail("setup", f"Passwort fuer {acct} wurde nicht gesetzt")
        (T / "etc/sudoers.d").mkdir(exist_ok=True)
        (T / "etc/sudoers.d/wheel").write_text("%wheel ALL=(ALL:ALL) ALL\n")
        os.chmod(T / "etc/sudoers.d/wheel", 0o440)
        self.progress("configure", 0.3)
        # VoidStation selbst: dasselbe install.sh wie bei jeder Installation, nur ohne Internet
        inst = T / "usr/local/share/voidstation/install.sh"
        if not inst.exists():
            raise Fail("no_payload", str(inst))
        pwf = T / "root/.voidstation-smbpass"                # Passwort per Datei, nicht in der Befehlszeile
        pwf.parent.mkdir(exist_ok=True)
        fd = os.open(pwf, os.O_WRONLY | os.O_CREAT | os.O_TRUNC, 0o600)
        with os.fdopen(fd, "w") as f:
            f.write(u["password"])
        env = ["env", f"VSUSER={login}", f"VSNAME={u['name']}", "SMBPASS_FILE=/root/.voidstation-smbpass",
               "SVDIR=/etc/runit/runsvdir/default", "VOIDSTATION_CHROOT=1", "VOIDSTATION_OFFLINE=1",
               "VOIDSTATION_NONINTERACTIVE=1", "VOIDSTATION_NOSSH=1", "HOME=/root", "TERM=dumb"]
        try:
            r = chroot(env + ["bash", "/usr/local/share/voidstation/install.sh"], check=False)
        finally:
            pwf.unlink(missing_ok=True)
        if r.returncode != 0:
            raise Fail("setup", (r.stdout + r.stderr)[-400:])
        self.progress("configure", 0.8)
        # Wahl aus dem Installer uebernehmen
        vs = T / "home" / login / ".local/share/voidstation"
        vs.mkdir(parents=True, exist_ok=True)
        sj = vs / "settings.json"
        try:
            s = json.loads(sj.read_text(encoding="utf-8"))
        except (OSError, ValueError):
            s = {}
        live = Path(c.get("live_home") or "/home/tv") / ".local/share/voidstation"
        try:                                           # Bildschirm-Einstellungen aus dem Live-System mitnehmen
            ls = json.loads((live / "settings.json").read_text(encoding="utf-8"))
            for k in ("scale", "resolution", "cursor_theme", "cursor_size"):
                if ls.get(k) is not None:
                    s[k] = ls[k]
        except (OSError, ValueError):
            pass
        s["lang"] = lang
        sj.write_text(json.dumps(s, indent=2), encoding="utf-8")
        if c.get("favorites"):
            for f in ("radio.json", "tvfavs.json"):
                if (live / f).is_file():
                    shutil.copy2(live / f, vs / f)
        chroot(["chown", "-R", f"{login}:{login}", f"/home/{login}/.local"])
        sv = T / "etc/runit/runsvdir/default"
        for s_ in ("sshd",) + (() if c.get("share", True) else ("smbd", "nmbd")):
            if (sv / s_).is_symlink():
                (sv / s_).unlink()                         # Fernzugriff: Einstellungen → System
        if c.get("wifi"):
            src = Path("/etc/NetworkManager/system-connections")
            dst = T / "etc/NetworkManager/system-connections"
            if src.is_dir():
                dst.mkdir(parents=True, exist_ok=True)
                os.chmod(dst, 0o700)
                for f in src.iterdir():
                    if f.is_file():
                        shutil.copy2(f, dst / f.name)
                        os.chmod(dst / f.name, 0o600)
        ch = T / "usr/local/share/voidstation/channel"
        ch.parent.mkdir(parents=True, exist_ok=True)
        ch.write_text(("main" if c.get("channel") == "main" else "stable") + "\n")
        os.chmod(ch, 0o644)
        self.progress("configure", 1)

    # --- 7. Startmanager
    def foreign_loaders(self):
        """EFI-Lader anderer Systeme auf allen EFI-Partitionen (fuer GRUB-Eintraege)."""
        out = []
        lsb = json.loads(sh(["lsblk", "-J", "-o", "PATH,PARTTYPE,FSTYPE,UUID"], quiet=True).stdout)

        def walk(nodes):
            for n in nodes or []:
                yield n
                yield from walk(n.get("children"))
        for n in walk(lsb.get("blockdevices")):
            if (n.get("parttype") or "").lower() == GUID["esp"] and n.get("fstype") == "vfat":
                if n["path"] == self.st["esp_dev"]:
                    loaders = esp_loaders(TARGET / "boot/efi")
                else:
                    loaders = with_mount(n["path"], "vfat", esp_loaders) or []
                for l in loaders:
                    if l["vendor"] in ("voidstation", "void_grub", "boot"):
                        continue
                    out.append(dict(l, uuid=n.get("uuid") or blkid(n["path"], "UUID")))
        return out

    def ph_boot(self):
        c = self.cfg
        self.mount_target()
        self.mount_pseudo()
        T = TARGET
        kvers = sorted((p.name[len("vmlinuz-"):] for p in (T / "boot").glob("vmlinuz-*")
                        if (T / "usr/lib/modules" / p.name[len("vmlinuz-"):]).is_dir()),
                       key=lambda v: [int(x) if x.isdigit() else 0 for x in re.split(r"[._-]", v)])
        if not kvers:
            raise Fail("no_kernel")
        # BIOS-GRUB kann keine EFI-Lader anderer Systeme starten (im BIOS-Modus gibt es ohnehin nur "ganze SSD")
        others = [] if self.bios else [o for o in self.foreign_loaders() if o.get("uuid")]
        dual = bool(others) or c["mode"] != "whole"
        esp_free = shutil.disk_usage(T / "boot/efi").free
        use_stub = not self.bios and not dual and esp_free > 150 * MiB and not self.alt
        self.st["boot"] = {"firmware": "bios" if self.bios else "uefi", "dual": dual, "efistub": use_stub,
                           "others": [o["name"] for o in others]}
        save_state(self.st)
        grubdef = T / "etc/default/grub"
        txt = grubdef.read_text() if grubdef.exists() else ""
        for k, v in (("GRUB_TIMEOUT", "3" if dual else "0"), ("GRUB_TIMEOUT_STYLE", "menu" if dual else "hidden"),
                     ("GRUB_DISABLE_OS_PROBER", "true"), ("GRUB_DISTRIBUTOR", '"VoidStation"')):
            txt = re.sub(rf"^#?\s*{k}=.*\n?", "", txt, flags=re.M) + f"{k}={v}\n"
        # Kernel-Parameter, ohne die dieser Rechner nicht startet, vom Stick uebernehmen
        # (forcepae: Pentium M melden PAE nicht – ohne ihn startet der 32-Bit-Kernel dort nicht)
        m = re.search(r'^GRUB_CMDLINE_LINUX="([^"]*)"', txt, flags=re.M)
        carry = [a for a in carry_cmdline() if not (m and a in m.group(1).split())]
        if carry:
            if m:
                txt = txt[:m.start(1)] + " ".join(m.group(1).split() + carry) + txt[m.end(1):]
            else:
                txt += f'GRUB_CMDLINE_LINUX="{" ".join(carry)}"\n'
            log("Kernel-Parameter uebernommen: " + " ".join(carry))
        grubdef.write_text(txt)
        # Eintraege fuer andere Systeme: deren eigener EFI-Lader wird gestartet (bleibt bei deren Updates gueltig)
        gd = T / "etc/grub.d/40_voidstation_andere"
        if others:
            lines = ["#!/bin/sh", "# VoidStation: andere Systeme ueber ihren eigenen EFI-Lader starten", "exec tail -n +4 $0"]
            for o in others:
                lines += [f'menuentry "{o["name"].replace(chr(34), "")}" {{', "    insmod part_gpt", "    insmod fat",
                          f'    search --no-floppy --fs-uuid --set=root {o["uuid"]}',
                          f'    chainloader "{o["path"]}"', "}"]
            gd.write_text("\n".join(lines) + "\n")
            os.chmod(gd, 0o755)
        elif gd.exists():
            gd.unlink()
        # EFISTUB (nur ganze SSD): Kernel direkt starten, GRUB bleibt als Rueckfall. Der Kernel liegt unter
        # festen Namen auf der EFI-Partition, der Eintrag "VoidStation EFISTUB" bleibt bei Kernel-Updates gleich
        # (voidstation-efistub, von install.sh nach /usr/local/sbin gelegt; Hooks in /etc/kernel.d)
        ru = blkid(self.dev("root"), "UUID")
        espdev = self.dev("esp")
        disk = "/dev/" + sh(["lsblk", "-no", "PKNAME", espdev], quiet=True).stdout.split()[0]
        partno = Path(f"/sys/class/block/{Path(espdev).name}/partition").read_text().strip()
        efistub = T / "usr/local/sbin/voidstation-efistub"
        if use_stub and not efistub.exists():
            log("voidstation-efistub fehlt im Zielsystem – Start nur ueber GRUB")
            use_stub = False
            self.st["boot"]["efistub"] = False
            save_state(self.st)
        if use_stub:
            (T / "etc/default/voidstation-efistub").write_text(
                "# VoidStation: Kernel direkt starten (EFISTUB). Nach Aenderungen:  sudo voidstation-efistub\n"
                f'ESP="/boot/efi"\nDISK="{disk}"\nPART={partno}\n'
                f'OPTIONS="{" ".join([f"root=UUID={ru}", "ro", "quiet", "loglevel=3", "rd.udev.log_level=3"] + carry_cmdline())}"\n')
            chroot(["/usr/local/sbin/voidstation-efistub", "--setup"], check=False)
        elif efistub.exists():
            chroot(["/usr/local/sbin/voidstation-efistub", "--remove"], check=False)
        else:
            (T / "etc/default/efibootmgr-kernel-hook").write_text("MODIFY_EFI_ENTRIES=0\n")
            for f in ("etc/kernel.d/post-install/40-voidstation-esp", "etc/kernel.d/post-install/60-voidstation-bootorder",
                      "etc/kernel.d/post-remove/40-voidstation-esp"):
                (T / f).unlink(missing_ok=True)
        self.progress("boot", 0.15)
        # GRUB
        bootx = None
        efi = T / "boot/efi/EFI"
        for d in efi.iterdir() if efi.is_dir() else []:
            if d.name.lower() == "boot" and d.is_dir():
                bootx = next((f for f in d.iterdir() if f.name.lower() == "bootx64.efi"), None)
        ours = efi / "VoidStation/grubx64.efi"
        if bootx and ours.exists() and filecmp.cmp(bootx, ours, shallow=False):
            bootx = None                                   # der Standard-Starter ist schon unser GRUB (frueherer Versuch)
        base = ["grub-install", "--target=x86_64-efi", "--efi-directory=/boot/efi", "--bootloader-id=VoidStation"]
        if self.bios:
            # GRUB in den Startbereich der SSD (Kern landet in der BIOS-Boot-Partition)
            r = chroot(["grub-install", "--target=i386-pc", disk], check=False)
            if r.returncode != 0:
                raise Fail("grub", (r.stdout + r.stderr)[-400:])
            # Dazu GRUB fuer UEFI auf den Standardpfad, ohne NVRAM-Eintrag (im BIOS-Modus gibt es keinen):
            # steht die Firmware spaeter auf UEFI, startet dieselbe SSD trotzdem
            chroot(base + ["--removable", "--no-nvram"], check=False)
        elif self.alt:
            # Ausweichweg: kein NVRAM-Eintrag, nur der Standard-Starter (wenn er frei ist oder schon uns gehoert)
            if bootx and dual:
                raise Fail("efi_fallback_taken")
            r = chroot(base + ["--removable", "--no-nvram"], check=False)
            if r.returncode != 0:
                raise Fail("grub", (r.stdout + r.stderr)[-400:])
        else:
            r = chroot(base, check=False)
            if r.returncode != 0:
                out = r.stdout + r.stderr
                full = shutil.disk_usage(T / "boot/efi").free < 8 * MiB
                raise Fail("esp_full" if full else "efi_nvram" if re.search(r"efibootmgr|EFI variable|NVRAM|No space left", out, re.I)
                           else "grub", out[-400:])
            if not dual or bootx is None:
                chroot(base + ["--removable"], check=False)   # Standardpfad als Rueckfall, wenn er frei ist
        self.progress("boot", 0.5)
        # Initramfs + Kernel-Hooks (EFISTUB-Eintrag) fuer jeden Kernel; allgemeines Initramfs,
        # weil es im chroot vom Live-System aus gebaut wird (hostonly wuerde die Live-Hardware-Sicht nehmen)
        dc = T / "etc/dracut.conf.d"
        dc.mkdir(parents=True, exist_ok=True)
        tmpl = T / "usr/local/share/voidstation/dracut-voidstation.conf"   # von install.sh (launcher/dracut-voidstation.conf)
        (dc / "10-voidstation.conf").write_text(tmpl.read_text() if tmpl.exists() else
                                                '# VoidStation: Initramfs fuer jede Hardware\nhostonly="no"\n'
                                                'omit_dracutmodules+=" drm plymouth "\n')
        for kv in kvers:
            pkg = "linux" + ".".join(kv.split(".")[:2])
            r = chroot(["xbps-reconfigure", "-f", pkg], check=False)
            if r.returncode != 0 or not (T / f"boot/initramfs-{kv}.img").exists():
                chroot(["dracut", "--no-hostonly", "--force", f"/boot/initramfs-{kv}.img", kv])
        if use_stub:
            # meist schon per Kernel-Hook erledigt; noetig, wenn oben nur dracut lief
            chroot(["/usr/local/sbin/voidstation-efistub"], check=False)
        self.progress("boot", 0.85)
        chroot(["grub-mkconfig", "-o", "/boot/grub/grub.cfg"])

    # --- 8. Abschluss
    def ph_cleanup(self):
        try:
            self.mount_target()
            shutil.copy2(LOG, TARGET / "var/log/voidstation-install.log")
            os.chmod(TARGET / "var/log/voidstation-install.log", 0o600)
        except (OSError, Fail):
            pass
        self.umount_all()


CARRY_ARGS = ("forcepae",)          # Kernel-Parameter des Sticks, die das installierte System auch braucht


def carry_cmdline():
    """Parameter aus CARRY_ARGS, mit denen der Stick gestartet wurde (fuer GRUB bzw. EFISTUB des Zielsystems)."""
    try:
        args = Path("/proc/cmdline").read_text().split()
    except OSError:
        return []
    return [a for a in CARRY_ARGS if a in args]


def nvidia_active():
    """Haengt eine Grafikkarte am NVIDIA-Treiber (Startmenue "NVIDIA only")? Ein geladenes Modul allein
    reicht nicht – das kann auch ohne gebundene Karte geladen sein."""
    for d in Path("/sys/bus/pci/devices").glob("*"):
        try:
            if (d / "class").read_text().startswith("0x03") and os.path.basename(os.readlink(d / "driver")) == "nvidia":
                return True
        except OSError:
            continue
    return False


def disk_of(dev):
    r = sh(["lsblk", "-no", "PKNAME", dev], check=False, quiet=True).stdout.split()
    return "/dev/" + r[0] if r else None


def dev_type(dev):
    return sh(["lsblk", "-dno", "TYPE", dev], check=False, quiet=True).stdout.strip()


def validate(cfg):
    """Einstellungen aus der Oberflaeche pruefen, bevor irgendetwas veraendert wird. Gibt Fehlerkennung oder None."""
    mode, disk = cfg.get("mode"), cfg.get("disk", "")
    if mode not in ("whole", "beside", "free", "manual"):
        return "bad_config"
    if not re.fullmatch(r"/dev/[A-Za-z0-9/_-]+", disk) or dev_type(disk) not in DISK_TYPES:
        return "no_disk"
    if disk in live_disks():
        return "live_disk"
    tr = sh(["lsblk", "-dno", "TRAN,RM", disk], check=False, quiet=True).stdout.split()
    if not TEST and (("usb" in tr) or tr[-1:] == ["1"]):
        return "no_disk"                                  # USB-Laufwerke werden nicht angeboten
    u = cfg.get("user") or {}
    name, login, pw = u.get("name", ""), u.get("login", ""), u.get("password", "")
    if not re.fullmatch(r"[a-z_][a-z0-9_-]{0,30}", login) or login in ("root", "tv", "nobody"):
        return "bad_login"
    try:
        pwd.getpwnam(login)                               # schon vergeben (Systemkonto wie dbus, sshd …)
        return "bad_login"
    except KeyError:
        pass
    if not name or re.search(r"[:,=\n\r\\\x00-\x1f]", name) or len(name) > 60:
        return "bad_name"
    if not pw or re.search(r"[\n\r\x00]", pw) or len(pw) > 200:
        return "bad_password"
    if not re.fullmatch(r"[A-Za-z0-9](?:[A-Za-z0-9-]{0,13}[A-Za-z0-9])?", cfg.get("hostname", "")):
        return "bad_hostname"
    if cfg.get("lang", "de") not in ("de", "en") or cfg.get("keymap", "de") not in ("de", "us", "gb"):
        return "bad_config"
    if cfg.get("live_home") and not re.fullmatch(r"/home/[a-z_][a-z0-9_-]{0,30}", str(cfg["live_home"])):
        return "bad_config"
    if mode == "beside":
        part = cfg.get("part", "")
        if not re.fullmatch(r"/dev/[A-Za-z0-9/_-]+", part) or disk_of(part) != disk:
            return "no_disk"
        try:
            if int(cfg.get("new_size", 0)) < MIN_ROOT:
                return "bad_size"
        except (TypeError, ValueError):
            return "bad_size"
    if mode == "free":
        r = cfg.get("region") or {}
        if not isinstance(r.get("start"), int) or not isinstance(r.get("sectors"), int) or r["start"] < 34:
            return "bad_size"
    if mode == "manual":
        m = cfg.get("manual") or {}
        root, esp = m.get("root", ""), m.get("esp", "")
        for d in (root, esp):
            if not re.fullmatch(r"/dev/[A-Za-z0-9/_-]+", d) or dev_type(d) != "part":
                return "no_disk"
        if root == esp or live_disks() & {disk_of(root), disk_of(esp)} or disk_of(root) != disk:
            return "bad_manual"
        if int(sh(["blockdev", "--getsize64", root], quiet=True).stdout) < MIN_ROOT - 512 * MiB:
            return "too_small"
    return None


LOCKF = None


def take_lock():
    """Nur eine Installation zur Zeit (auch nicht Oberflaeche und Terminal gleichzeitig)."""
    global LOCKF
    RUNDIR.mkdir(parents=True, exist_ok=True)
    os.chmod(RUNDIR, 0o700)
    LOCKF = open(RUNDIR / "lock", "w")
    try:
        fcntl.flock(LOCKF, fcntl.LOCK_EX | fcntl.LOCK_NB)
        return True
    except OSError:
        return False


def locked():
    try:
        with open(RUNDIR / "lock") as f:
            fcntl.flock(f, fcntl.LOCK_SH | fcntl.LOCK_NB)
            return False
    except FileNotFoundError:
        return False
    except OSError:
        return True


def cmd_run(args):
    if not take_lock():
        emit(ev="error", phase="check", code="busy", msg="Es laeuft schon eine Installation", done=[], log=[], alt=False)
        return 1
    if "--resume" in args:
        st = read_json_state()
        if not st:
            emit(ev="error", phase="check", code="no_state", msg="Kein Stand zum Fortsetzen")
            return 1
        st.pop("error", None)
        log("=== Neuer Versuch", "(Ausweichweg)" if "--alt" in args else "")
        if "--alt" in args and "boot" in st.get("done", []):
            st["done"].remove("boot")
    else:
        try:
            cfg = json.loads(sys.stdin.read() or "{}")
        except ValueError:
            cfg = {}
        bad = validate(cfg) if isinstance(cfg, dict) else "bad_config"
        if bad:
            emit(ev="error", phase="check", code=bad, msg=bad, done=[], foreign_untouched=True, log=[], alt=False)
            return 1
        if LOG.exists():
            LOG.rename(LOG.with_suffix(".log.alt"))
        st = {"config": cfg, "done": [], "started": time.time()}
        save_state(st)
        log("=== VoidStation-Installation", json.dumps({k: v for k, v in cfg.items() if k != "user"}, ensure_ascii=False))
    return Run(st).run(alt="--alt" in args)


