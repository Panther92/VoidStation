#!/usr/bin/python3 -I
# SPDX-License-Identifier: GPL-3.0-or-later
"""voidstation-mullvad – Mullvad VPN auf VoidStation (Root-Helfer, aufgerufen ueber "voidstation-pkg mullvad …").

Mullvad liefert fuer Linux nur .deb und .rpm mit systemd-Diensten. VoidStation laedt die offizielle .deb von GitHub,
prueft deren Signatur gegen den festen Code-Signing-Schluessel von Mullvad (Fingerabdruck A119 8702 … 66DE 8DDF,
/usr/local/share/voidstation/mullvad-signing.asc) und baut daraus ein eigenes xbps-Paket
"mullvad-vpn-voidstation": nur Daemon und Kommandozeile (keine Electron-Oberflaeche – die Bedienung macht die
Startseite), dazu ein runit-Dienst statt mullvad-daemon.service und ein Core-Service statt
mullvad-early-boot-blocking.service. Das Paket liegt in einem lokalen Repo unter /var/cache/voidstation/mullvad.

Befehle:  install | update | remove | status | latest
Ausgabe: Protokollzeilen fuer das AppCenter (Jobs), Fehler mit Rueckgabewert != 0.
"""
import json
import os
import re
import shutil
import subprocess
import sys
import tarfile
import tempfile
import time
import urllib.request
from pathlib import Path

PKG = "mullvad-vpn-voidstation"
REPO_GH = "mullvad/mullvadvpn-app"
# Release-Liste statt /releases/latest: Mullvad veroeffentlicht Desktop und Android im selben Repo, "latest" ist
# zeitweise das Android-Release ("android/2026.12"). Aus der Liste zaehlt die hoechste freigegebene Desktop-Version.
API = f"https://api.github.com/repos/{REPO_GH}/releases?per_page=100"
DL = f"https://github.com/{REPO_GH}/releases/download/{{ver}}/MullvadVPN-{{ver}}_amd64.deb"
KEYFILE = Path("/usr/local/share/voidstation/mullvad-signing.asc")
KEY_FPR = "A1198702FC3E0A09A9AE5B75D5A1D4F266DE8DDF"     # Mullvad (code signing) <admin@mullvad.net>
LOCALREPO = Path("/var/cache/voidstation/mullvad")
RESDIR = "/opt/Mullvad VPN/resources/"
SV = Path("/etc/sv/mullvad-daemon")
SVLINK = Path("/var/service/mullvad-daemon")
SETTINGS = Path("/etc/mullvad-vpn/settings.json")
UA = {"User-Agent": "VoidStation (+https://voidstation.de)"}
VER_RE = re.compile(r"^20\d\d\.\d{1,2}$")                # nur freigegebene Versionen, keine Betas ("2026.5-beta2")

# Was aus der .deb uebernommen wird (Pfad im Paket -> Rechte). Alles andere (Electron, Icons, Desktop-Datei,
# systemd-Units, AppArmor) bleibt draussen. mullvad-exclude ohne setuid: Split-Tunneling bietet VoidStation nicht an.
TAKE = {
    "usr/bin/mullvad": 0o755,
    "usr/bin/mullvad-daemon": 0o755,
    "usr/bin/mullvad-exclude": 0o755,
    "opt/Mullvad VPN/resources/mullvad-setup": 0o755,
    "opt/Mullvad VPN/resources/mullvad-problem-report": 0o755,
    "opt/Mullvad VPN/resources/ca.crt": 0o644,
    "opt/Mullvad VPN/resources/relays.json": 0o644,
    "opt/Mullvad VPN/resources/CHANGELOG.md": 0o644,
    "usr/share/bash-completion/completions/mullvad": 0o644,
}
NEED = ("usr/bin/mullvad", "usr/bin/mullvad-daemon", "opt/Mullvad VPN/resources/mullvad-setup",
        "opt/Mullvad VPN/resources/ca.crt", "opt/Mullvad VPN/resources/relays.json")

RUN = f"""#!/bin/sh
# VoidStation: Mullvad VPN (ersetzt mullvad-daemon.service). Der Daemon schreibt sein Protokoll selbst nach
# /var/log/mullvad-vpn/daemon.log. DNS: erkennt systemd-resolved, NetworkManager, resolvconf oder /etc/resolv.conf
# selbst; erzwingen ginge mit TALPID_DNS_MODULE=network-manager (bzw. static-file).
export MULLVAD_RESOURCE_DIR="{RESDIR}"
exec /usr/bin/mullvad-daemon -v --disable-stdout-timestamps >/dev/null 2>&1
"""

# Laeuft in Stufe 1 (vor runsvdir und damit vor NetworkManager), wird von /etc/runit/1 eingelesen: kein exit.
# Sperrt den Verkehr nur, wenn der Lockdown-Modus bzw. "Beim Start verbinden" an ist – wie die systemd-Unit.
CORE = f"""# VoidStation: Mullvad VPN – Sperre beim Start (ersetzt mullvad-early-boot-blocking.service)
if [ -x /usr/bin/mullvad-daemon ]; then
  MULLVAD_RESOURCE_DIR="{RESDIR}" timeout 10 /usr/bin/mullvad-daemon -v --initialize-early-boot-firewall >/dev/null 2>&1 || true
fi
"""
CORE_PATH = "etc/runit/core-services/95-voidstation-mullvad.sh"


def say(*a):
    print(*a, flush=True)


def run(args, timeout=None, env=None, check=False):
    try:
        r = subprocess.run(args, stdout=subprocess.PIPE, stderr=subprocess.STDOUT, text=True, timeout=timeout,
                           env=env, stdin=subprocess.DEVNULL)
    except (OSError, subprocess.SubprocessError) as e:
        if check:
            raise RuntimeError(f"{args[0]}: {e}") from e
        return None
    if check and r.returncode != 0:
        raise RuntimeError(f"{' '.join(args[:3])}: {r.stdout.strip().splitlines()[-1] if r.stdout.strip() else r.returncode}")
    return r


def env_mullvad():
    return {**os.environ, "MULLVAD_RESOURCE_DIR": RESDIR}


def installed_version():
    r = run(["xbps-query", "-p", "pkgver", PKG])
    if not r or r.returncode != 0 or not r.stdout.strip():
        return None
    m = re.match(rf"^{re.escape(PKG)}-(.+)_\d+$", r.stdout.strip())
    return m.group(1) if m else None


def _vkey(tag):
    """Versionsnummer zum Vergleichen: "2026.10" -> (2026, 10), damit 2026.10 nach 2026.5 kommt."""
    return tuple(int(x) for x in tag.split("."))


def latest():
    """Neueste freigegebene Desktop-Version: kein Entwurf, keine Vorabversion, Tag wie "2026.5" und mit .deb fuer amd64."""
    req = urllib.request.Request(API, headers={**UA, "Accept": "application/vnd.github+json"})
    with urllib.request.urlopen(req, timeout=30) as r:
        rels = json.load(r)
    if not isinstance(rels, list):
        raise RuntimeError("unerwartete Antwort von GitHub (keine Release-Liste)")
    tags = []
    for rel in rels:
        tag = str(rel.get("tag_name") or "")
        if rel.get("draft") or rel.get("prerelease") or not VER_RE.match(tag):
            continue
        if f"MullvadVPN-{tag}_amd64.deb" in {a.get("name") for a in rel.get("assets") or []}:
            tags.append(tag)
    if not tags:
        raise RuntimeError("keine freigegebene Desktop-Version von Mullvad gefunden")
    return max(tags, key=_vkey)


def download(url, dest):
    req = urllib.request.Request(url, headers=UA)
    with urllib.request.urlopen(req, timeout=60) as r, open(dest, "wb") as f:
        total = int(r.headers.get("Content-Length") or 0)
        done, last = 0, 0
        while True:
            chunk = r.read(1 << 18)
            if not chunk:
                break
            f.write(chunk)
            done += len(chunk)
            if total and done * 10 // total > last:
                last = done * 10 // total
                say(f"… {last * 10} %")
    return done


def verify(deb, asc, work):
    """Signatur pruefen: gueltig UND vom festen Mullvad-Schluessel (Hauptschluessel-Fingerabdruck in VALIDSIG)."""
    if not shutil.which("gpg"):
        raise RuntimeError("gpg fehlt (Paket gnupg) – Signatur kann nicht geprueft werden")
    if not KEYFILE.is_file():
        raise RuntimeError(f"Schluessel fehlt: {KEYFILE}")
    home = Path(work) / "gnupg"
    home.mkdir(mode=0o700)
    g = ["gpg", "--homedir", str(home), "--batch", "--no-tty", "--no-auto-key-retrieve"]
    run(g + ["--import", str(KEYFILE)], timeout=60, check=True)
    r = run(g + ["--status-fd", "1", "--verify", str(asc), str(deb)], timeout=120)
    if not r or r.returncode != 0:
        raise RuntimeError("Signatur UNGUELTIG – Download verworfen")
    for line in r.stdout.splitlines():
        p = line.split()
        if len(p) >= 3 and p[0] == "[GNUPG:]" and p[1] == "VALIDSIG" and p[-1].upper() == KEY_FPR:
            return True
    raise RuntimeError("Signatur nicht vom Mullvad-Code-Signing-Schluessel – Download verworfen")


def ar_members(path):
    """Mitglieder einer .deb (ar-Archiv): {name: bytes}."""
    out = {}
    with open(path, "rb") as f:
        if f.read(8) != b"!<arch>\n":
            raise RuntimeError("keine .deb-Datei")
        while True:
            hdr = f.read(60)
            if len(hdr) < 60:
                break
            name = hdr[:16].decode("ascii", "replace").strip().rstrip("/")
            size = int(hdr[48:58].decode("ascii").strip())
            data = f.read(size)
            if size % 2:
                f.read(1)
            out[name] = data
    return out


def data_tar(members, work):
    for name, data in members.items():
        if not name.startswith("data.tar"):
            continue
        p = Path(work) / name
        p.write_bytes(data)
        if name.endswith(".zst"):
            try:
                from compression import zstd                     # Python 3.14
                raw = zstd.decompress(data)
            except ImportError:
                if not shutil.which("zstd"):
                    raise RuntimeError("zstd fehlt – .deb nicht entpackbar") from None
                r = subprocess.run(["zstd", "-dc", str(p)], stdout=subprocess.PIPE, check=True)
                raw = r.stdout
            p = Path(work) / "data.tar"
            p.write_bytes(raw)
        return p
    raise RuntimeError("data.tar fehlt in der .deb")


def extract(deb, dest, work):
    """Nur die Dateien aus TAKE nach dest – keine Links nach aussen, kein setuid, root:root."""
    tar = data_tar(ar_members(deb), work)
    found = set()
    with tarfile.open(tar) as t:
        for m in t.getmembers():
            name = m.name.lstrip("./")
            if name == "usr/bin/mullvad-problem-report" and m.issym():
                continue                                    # Link auf resources/ – legen wir selbst an
            if name not in TAKE or not m.isfile():
                continue
            target = dest / name
            target.parent.mkdir(parents=True, exist_ok=True)
            src = t.extractfile(m)
            if src is None:                         # kann nach isfile() nicht vorkommen
                continue
            with src, open(target, "wb") as f:
                shutil.copyfileobj(src, f)
            os.chmod(target, TAKE[name])
            found.add(name)
    missing = [n for n in NEED if n not in found]
    if missing:
        raise RuntimeError("in der .deb fehlt: " + ", ".join(missing))
    link = dest / "usr/bin/mullvad-problem-report"
    link.symlink_to(RESDIR + "mullvad-problem-report")
    sv = dest / "etc/sv/mullvad-daemon"
    sv.mkdir(parents=True)
    (sv / "run").write_text(RUN)
    os.chmod(sv / "run", 0o755)
    core = dest / CORE_PATH
    core.parent.mkdir(parents=True, exist_ok=True)
    core.write_text(CORE)
    os.chmod(core, 0o644)
    for p in dest.rglob("*"):
        os.lchown(p, 0, 0)


def build_pkg(dest, ver, work):
    arch = (run(["xbps-uhelper", "arch"]) or subprocess.CompletedProcess([], 1, "")).stdout.strip() or "x86_64"
    if arch != "x86_64":
        raise RuntimeError(f"Mullvad gibt es nur fuer x86_64 (dieses Geraet: {arch})")
    out = Path(work) / "pkg"
    out.mkdir()
    # xbps-create schreibt das Paket ins aktuelle Verzeichnis
    r = subprocess.run(["xbps-create", "-A", arch, "-n", f"{PKG}-{ver}_1", "-s",
                        "Mullvad VPN – Daemon und CLI aus der offiziellen .deb (VoidStation)",
                        "-l", "GPL-3.0-only", "-H", "https://mullvad.net",
                        "-m", "VoidStation <https://voidstation.de>", str(dest)],
                       cwd=out, stdout=subprocess.PIPE, stderr=subprocess.STDOUT, text=True, timeout=300)
    if r.returncode != 0:
        raise RuntimeError("xbps-create: " + (r.stdout.strip().splitlines() or ["?"])[-1])
    pkgs = list(out.glob("*.xbps"))
    if len(pkgs) != 1:
        raise RuntimeError("xbps-create hat kein Paket erzeugt")
    LOCALREPO.mkdir(parents=True, exist_ok=True)
    os.chmod(LOCALREPO, 0o755)
    for old in list(LOCALREPO.glob("*.xbps")) + list(LOCALREPO.glob("*-repodata*")):
        old.unlink()
    final = LOCALREPO / pkgs[0].name
    shutil.move(str(pkgs[0]), final)
    os.chmod(final, 0o644)
    run(["xbps-rindex", "-a", str(final)], timeout=120, check=True)
    return final


def daemon_running():
    r = run(["sv", "status", str(SV)], timeout=10)
    return bool(r and r.stdout.startswith("run:"))


def wait_socket(seconds=20):
    for _ in range(seconds * 2):
        if Path("/var/run/mullvad-vpn").exists():
            return True
        time.sleep(0.5)
    return False


def cmd_install():
    have = installed_version()
    ver = latest()
    if have == ver and SV.is_dir():
        say(f"Mullvad VPN {ver} ist aktuell")
        return enable()
    fresh = not SETTINGS.exists()
    say(f"Mullvad VPN {ver}" + (f" (vorher {have})" if have else ""))
    work = tempfile.mkdtemp(prefix="voidstation-mullvad.")
    try:
        deb = Path(work) / f"MullvadVPN-{ver}_amd64.deb"
        say(f"Lade {deb.name} …")
        download(DL.format(ver=ver), deb)
        download(DL.format(ver=ver) + ".asc", Path(str(deb) + ".asc"))
        verify(deb, Path(str(deb) + ".asc"), work)
        say("Signatur geprueft: ok (Mullvad Code Signing)")
        dest = Path(work) / "dest"
        dest.mkdir()
        extract(deb, dest, work)
        say("Baue Paket …")
        build_pkg(dest, ver, work)
    finally:
        shutil.rmtree(work, ignore_errors=True)
    if have and daemon_running():                      # wie before-install.sh: Sperre halten, dann anhalten
        run(["/opt/Mullvad VPN/resources/mullvad-setup", "prepare-restart"], timeout=20, env=env_mullvad())
        run(["sv", "stop", str(SV)], timeout=30)
    args = ["xbps-install", "-y"] + (["-u"] if have else []) + ["--repository", str(LOCALREPO), PKG]
    r = subprocess.run(args, stdout=sys.stdout, stderr=subprocess.STDOUT)
    if r.returncode != 0:
        raise RuntimeError("Paket konnte nicht installiert werden")
    rc = enable()
    if rc == 0 and fresh:
        # Heimnetz erlauben: SSH, LocalSend, Freigaben und der Controller per Handy bleiben erreichbar
        run(["mullvad", "lan", "set", "allow"], timeout=20)
        say("Heimnetz erlaubt (Einstellung in Mullvad VPN → Optionen)")
    return rc


def enable():
    if not SVLINK.exists():
        SVLINK.symlink_to(SV)
    run(["sv", "up", str(SV)], timeout=10)
    if not wait_socket():
        say("Mullvad-Dienst startet nicht – Protokoll: /var/log/mullvad-vpn/daemon.log")
        return 1
    say("Mullvad-Dienst laeuft")
    return 0


def cmd_remove():
    have = installed_version()
    if Path("/usr/bin/mullvad").exists():
        # wie before-remove.sh: Geraet beim Konto abmelden (gibt den Platz frei), Firewall-Regeln weg
        run(["/opt/Mullvad VPN/resources/mullvad-setup", "remove-device"], timeout=30, env=env_mullvad())
    if SVLINK.is_symlink() or SVLINK.exists():
        run(["sv", "stop", str(SV)], timeout=30)
        SVLINK.unlink()
        time.sleep(1)
    if Path("/opt/Mullvad VPN/resources/mullvad-setup").exists():
        run(["/opt/Mullvad VPN/resources/mullvad-setup", "reset-firewall"], timeout=20, env=env_mullvad())
    if have:
        r = subprocess.run(["xbps-remove", "-y", PKG], stdout=sys.stdout, stderr=subprocess.STDOUT)
        if r.returncode != 0:
            say("Paket konnte nicht entfernt werden")
            return 1
    for d in (LOCALREPO, Path("/etc/mullvad-vpn"), Path("/var/cache/mullvad-vpn"), Path("/var/log/mullvad-vpn")):
        shutil.rmtree(d, ignore_errors=True)
    say("Mullvad VPN entfernt")
    return 0


def cmd_status():
    have = installed_version()
    print(json.dumps({"installed": have, "running": daemon_running() if have else False}))
    return 0


def main(argv):
    if os.geteuid() != 0:
        print("nur als root (sudo voidstation-pkg mullvad …)", file=sys.stderr)
        return 2
    cmd = argv[0] if argv else ""
    try:
        if cmd in ("install", "update"):
            return cmd_install()
        if cmd == "remove":
            return cmd_remove()
        if cmd == "status":
            return cmd_status()
        if cmd == "latest":
            print(latest())
            return 0
    except (RuntimeError, OSError, ValueError, subprocess.SubprocessError, tarfile.TarError) as e:
        say(f"Fehler: {e}")
        return 1
    print("Benutzung: voidstation-pkg mullvad install|update|remove|status|latest", file=sys.stderr)
    return 2


if __name__ == "__main__":
    sys.exit(main(sys.argv[1:]))
