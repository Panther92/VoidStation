#!/usr/bin/python3 -I
# SPDX-License-Identifier: GPL-3.0-or-later
"""voidstation-mullvad – Mullvad VPN auf VoidStation (Root-Helfer, aufgerufen ueber "voidstation-pkg mullvad …").

Seit 2026.12 kommt Mullvad als Paket "mullvad-vpn" aus der eigenen Paketquelle (repo.voidstation.de,
github.com/Panther92/voidstation-packages): Die CI laedt dort die offizielle .deb, prueft deren Signatur gegen den
Code-Signing-Schluessel von Mullvad (Fingerabdruck A119 8702 … 66DE 8DDF) und packt nur Daemon und Kommandozeile
(keine Electron-Oberflaeche – die Bedienung macht die Startseite), dazu ein runit-Dienst statt mullvad-daemon.service
und ein Core-Service statt mullvad-early-boot-blocking.service. Das Paket ist mit dem Schluessel der Paketquelle
signiert; xbps prueft das. Es ersetzt das frueher auf jedem Geraet selbst gebaute "mullvad-vpn-voidstation"
(gleicher Inhalt, gleiche Pfade, replaces im Paket).

Dieser Helfer erledigt, was xbps nicht weiss: Dienst einschalten, beim Wechsel die Sperre halten
("prepare-restart"), beim Entfernen das Geraet beim Konto abmelden, beim ersten Mal das Heimnetz erlauben.

Befehle:  install | update | remove | status | latest | restart
Ausgabe: Protokollzeilen fuer das AppCenter (Jobs), Fehler mit Rueckgabewert != 0.
"""
import json
import os
import re
import shutil
import subprocess
import sys
import time
from pathlib import Path

PKG = "mullvad-vpn"
OLD_PKG = "mullvad-vpn-voidstation"                     # bis 2026.11 auf dem Geraet aus der .deb gebaut
OLD_LOCALREPO = Path("/var/cache/voidstation/mullvad")  # dessen lokales Repo
RESDIR = "/opt/Mullvad VPN/resources/"
SV = Path("/etc/sv/mullvad-daemon")
SVLINK = Path("/var/service/mullvad-daemon")
SETTINGS = Path("/etc/mullvad-vpn/settings.json")


def say(*a):
    print(*a, flush=True)


def run(args, timeout=None, env=None):
    try:
        return subprocess.run(args, stdout=subprocess.PIPE, stderr=subprocess.STDOUT, text=True, timeout=timeout,
                              env=env, stdin=subprocess.DEVNULL)
    except (OSError, subprocess.SubprocessError):
        return None


def env_mullvad():
    return {**os.environ, "MULLVAD_RESOURCE_DIR": RESDIR}


def pkg_version(pkg, remote=False):
    """Version eines Pakets ("2026.5"), installiert oder (remote) in der Paketquelle; None = nicht da."""
    r = run(["xbps-query"] + (["-R"] if remote else []) + ["-p", "pkgver", pkg], timeout=60)
    if not r or r.returncode != 0 or not r.stdout.strip():
        return None
    m = re.match(rf"^{re.escape(pkg)}-(.+)_\d+$", r.stdout.strip().splitlines()[-1])
    return m.group(1) if m else None


def installed_version():
    return pkg_version(PKG) or pkg_version(OLD_PKG)


def latest():
    """Version in der Paketquelle (ohne frisches Laden der Paketlisten; das macht die Update-Pruefung)."""
    v = pkg_version(PKG, remote=True)
    if not v:
        raise RuntimeError("mullvad-vpn nicht in der Paketquelle (sudo voidstation-pkg repo status)")
    return v


def daemon_running():
    r = run(["sv", "status", str(SV)], timeout=10)
    return bool(r and r.stdout.startswith("run:"))


def wait_socket(seconds=20):
    for _ in range(seconds * 2):
        if Path("/var/run/mullvad-vpn").exists():
            return True
        time.sleep(0.5)
    return False


def hold_and_stop():
    """Wie before-install.sh der .deb: dem Daemon sagen, dass er gleich neu startet (Sperre bleibt), dann anhalten."""
    if daemon_running():
        run(["/opt/Mullvad VPN/resources/mullvad-setup", "prepare-restart"], timeout=20, env=env_mullvad())
        run(["sv", "stop", str(SV)], timeout=30)


def cmd_install():
    have = installed_version()
    old = pkg_version(OLD_PKG) is not None
    fresh = not SETTINGS.exists()
    r = run(["xbps-install", "-S"], timeout=300)                 # Paketlisten (auch die eigene Quelle)
    if not r or r.returncode != 0:
        say("Paketlisten konnten nicht geladen werden – versuche es mit dem Stand von vorher")
    ver = latest()
    if have == ver and not old and SV.is_dir():
        say(f"Mullvad VPN {ver} ist aktuell")
        return enable()
    say(f"Mullvad VPN {ver}" + (f" (vorher {have})" if have else ""))
    if have:
        hold_and_stop()
    # -u: Update; ein vorhandenes mullvad-vpn-voidstation ersetzt das Paket selbst (replaces)
    args = ["xbps-install", "-y"] + (["-u"] if have and not old else []) + [PKG]
    r2 = subprocess.run(args, stdout=sys.stdout, stderr=subprocess.STDOUT)
    if r2.returncode != 0:
        if have:
            run(["sv", "up", str(SV)], timeout=10)                # alte Fassung laeuft weiter
        raise RuntimeError("Paket konnte nicht installiert werden")
    if old:
        if pkg_version(OLD_PKG):
            run(["xbps-remove", "-y", OLD_PKG], timeout=120)
        shutil.rmtree(OLD_LOCALREPO, ignore_errors=True)
        say("Umgestellt auf das Paket aus der VoidStation-Paketquelle")
    rc = enable()
    if rc == 0 and fresh:
        # Heimnetz erlauben: SSH, LocalSend, Freigaben und der Controller per Handy bleiben erreichbar
        run(["mullvad", "lan", "set", "allow"], timeout=20)
        say("Heimnetz erlaubt (Einstellung in Mullvad VPN → Optionen)")
    return rc


def cmd_restart():
    """Nach einem System-Update (voidstation-pkg update), wenn xbps mullvad-vpn erneuert hat: neuen Daemon starten."""
    if not SVLINK.exists():
        return 0
    hold_and_stop()
    run(["sv", "up", str(SV)], timeout=10)
    if wait_socket():
        say("Mullvad-Dienst neu gestartet")
        return 0
    say("Mullvad-Dienst startet nicht – Protokoll: /var/log/mullvad-vpn/daemon.log")
    return 1


def enable():
    if not SVLINK.exists():
        SVLINK.symlink_to(SV)
    run(["sv", "up", str(SV)], timeout=10)
    if not wait_socket():
        say("Mullvad-Dienst startet nicht – Protokoll: /var/log/mullvad-vpn/daemon.log")
        return 1
    say("Mullvad-Dienst laeuft")
    return 0


def cmd_remove():
    if Path("/usr/bin/mullvad").exists():
        # wie before-remove.sh: Geraet beim Konto abmelden (gibt den Platz frei), Firewall-Regeln weg
        run(["/opt/Mullvad VPN/resources/mullvad-setup", "remove-device"], timeout=30, env=env_mullvad())
    if SVLINK.is_symlink() or SVLINK.exists():
        run(["sv", "stop", str(SV)], timeout=30)
        SVLINK.unlink()
        time.sleep(1)
    if Path("/opt/Mullvad VPN/resources/mullvad-setup").exists():
        run(["/opt/Mullvad VPN/resources/mullvad-setup", "reset-firewall"], timeout=20, env=env_mullvad())
    for pkg in (PKG, OLD_PKG):
        if pkg_version(pkg):
            r = subprocess.run(["xbps-remove", "-y", pkg], stdout=sys.stdout, stderr=subprocess.STDOUT)
            if r.returncode != 0:
                say("Paket konnte nicht entfernt werden")
                return 1
    for d in (OLD_LOCALREPO, Path("/etc/mullvad-vpn"), Path("/var/cache/mullvad-vpn"), Path("/var/log/mullvad-vpn")):
        shutil.rmtree(d, ignore_errors=True)
    say("Mullvad VPN entfernt")
    return 0


def cmd_status():
    have = installed_version()
    print(json.dumps({"installed": have, "running": daemon_running() if have else False}))
    return 0


def main(argv):
    if os.geteuid() != 0:
        print("nur als root (sudo voidstation-pkg mullvad …)", file=sys.stderr)
        return 2
    cmd = argv[0] if argv else ""
    try:
        if cmd in ("install", "update"):
            return cmd_install()
        if cmd == "remove":
            return cmd_remove()
        if cmd == "status":
            return cmd_status()
        if cmd == "restart":
            return cmd_restart()
        if cmd == "latest":
            print(latest())
            return 0
    except (RuntimeError, OSError, ValueError, subprocess.SubprocessError) as e:
        say(f"Fehler: {e}")
        return 1
    print("Benutzung: voidstation-pkg mullvad install|update|remove|status|latest|restart", file=sys.stderr)
    return 2


if __name__ == "__main__":
    sys.exit(main(sys.argv[1:]))
