#!/bin/sh
# vsctl home            -> laufendes Programm schliessen, zurueck zur Startseite
# vsctl launch <id>     -> Kachel starten (id aus tiles.json)
# vsctl status          -> was laeuft gerade?
# vsctl update          -> alle Updates wie Einstellungen → Updates: Void-Pakete (inkl. Kernel),
#                          Flatpak, AppImages, Proton-GE und VoidStation selbst; Protokoll laeuft mit
# vsctl version         -> installierte VoidStation-Version, Build und Update-Kanal
# vsctl / vsctl help    -> diese Uebersicht
# Tab-Vervollstaendigung (Befehle, Kachel-IDs): /etc/bash/bashrc.d/voidstation.sh
URL=http://127.0.0.1:8765/api
TV="$(dirname "$(readlink -f "$0")")"

usage() {
  cat <<'EOF'
vsctl – VoidStation von der Kommandozeile steuern

  vsctl home           laufendes Programm schließen, zurück zur Startseite
  vsctl launch <id>    Kachel starten (IDs: Tab-Taste nach "vsctl launch")
  vsctl status         was läuft gerade?
  vsctl update         alle Updates wie Einstellungen → Updates (mit Protokoll)
  vsctl version        installierte Version, Build und Update-Kanal
EOF
}

version() {
  python3 - "$TV/version.json" /usr/local/share/voidstation/channel <<'PYEOF'
import json, sys
try:
    v = json.load(open(sys.argv[1], encoding="utf-8"))
except (OSError, ValueError):
    v = {}
try:
    ch = open(sys.argv[2]).read().strip()
except OSError:
    ch = ""
print(f"VoidStation {v.get('version') or '?'}" + (f" (Build {v['build']})" if v.get("build") else ""))
print("Update-Kanal:", {"stable": "Stable", "main": "Testing"}.get(ch, ch or "?"))
PYEOF
}

update() {
  if ! curl -fsS -o /dev/null "$URL/status" 2>/dev/null; then
    # Oberflaeche laeuft nicht (z. B. per SSH bei kaputter Sitzung): direkt ueber den Root-Helfer
    echo "Oberfläche nicht erreichbar – aktualisiere direkt (ohne Flatpak/AppImages/Proton-GE)."
    sudo -n /usr/local/sbin/voidstation-pkg update && sudo -n /usr/local/sbin/voidstation-pkg selfupdate
    return $?
  fi
  curl -fsS -X POST -H 'X-TV: 1' "$URL/apps/update" >/dev/null || { echo "Es läuft schon ein Auftrag." >&2; return 1; }
  python3 - "$URL" <<'PYEOF'
import json, sys, time, urllib.request
url, seen = sys.argv[1], 0
while True:
    time.sleep(1)
    try:
        with urllib.request.urlopen(url + "/apps/job", timeout=10) as r:
            j = json.load(r)
    except OSError:
        continue
    n, lines = j.get("n", 0), j.get("log", [])
    for line in lines[max(0, len(lines) - (n - seen)):]:
        print(line, flush=True)
    seen = n
    if j.get("state") != "running":
        print("\nFertig." if j.get("state") == "done" else "\nNicht alles hat geklappt (siehe oben).")
        if j.get("reboot"):
            print("Neustart nötig:  sudo reboot")
        sys.exit(0 if j.get("state") == "done" else 1)
PYEOF
}

case "$1" in
  home)   curl -fsS -X POST -H 'X-TV: 1' "$URL/home" ;;
  launch) curl -fsS -X POST -H 'X-TV: 1' "$URL/launch/$2" ;;
  status) curl -fsS "$URL/status" ;;
  update) update; exit $? ;;
  version|--version|-V) version; exit $? ;;
  ""|help|-h|--help) usage; exit 0 ;;
  *) echo "vsctl: unbekannter Befehl \"$1\"" >&2; usage >&2; exit 1 ;;
esac
echo
